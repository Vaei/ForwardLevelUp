+	if (SubpassResolveMode != 0)
+	{
+		OutColor = float4(ResolveAndTonemapSubpassSamples(half3(ColorScale0.rgb * OneOverPreExposure)), 1.0);
+		return;
+	}
+#endif
+
 	half4 SceneColor = FetchAndResolveSceneColor(UV, GetEyeIndex(StereoInput));
 	SceneColor.a = 1.0;
 
