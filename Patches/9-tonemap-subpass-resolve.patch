index b73f03d0c09d..e3143a3ea999 100644
--- a/Engine/Shaders/Private/PostProcessTonemap.usf
+++ b/Engine/Shaders/Private/PostProcessTonemap.usf
@@ -673,6 +673,33 @@ void MainCS(uint2 DispatchThreadId : SV_DispatchThreadID)
 	#endif
 #endif
 
+uint SubpassResolveMode;
+
+#if VULKAN_PROFILE && SUBPASS_MSAA_SAMPLES > 1
+/** Resolves the samples on chip in the tonemapped domain: weighted by inverse luminance (1), or tonemapped one by one (2). */
+half3 ResolveAndTonemapSubpassSamples(half3 Scale)
+{
+	half3 Sum = 0;
+	half WeightSum = 0;
+	UNROLL
+	for (int SampleIndex = 0; SampleIndex < SUBPASS_MSAA_SAMPLES; SampleIndex++)
+	{
+		const half3 Sample = half3(VulkanSubpassFetch0(SampleIndex).rgb) * Scale;
+		if (SubpassResolveMode == 2)
+		{
+			Sum += ColorLookupTable(Sample);
+		}
+		else
+		{
+			const half Weight = rcp(1.0 + Luminance(Sample));
+			Sum += Sample * Weight;
+			WeightSum += Weight;
+		}
+	}
+	return SubpassResolveMode == 2 ? Sum / SUBPASS_MSAA_SAMPLES : ColorLookupTable(Sum / WeightSum);
+}
+#endif
+
 half4 FetchAndResolveSceneColor(float2 UV, float ArrayIndex)
 {
 	half4 SceneColor = half4(1.0, 1.0, 1.0, 1.0);
