+
+static FColor ComputeProbeGIBaseColor(const FPrimitiveSceneProxyDesc& InProxyDesc)
+{
+	TRACE_CPUPROFILER_EVENT_SCOPE(PrimitiveSceneProxy::GetProbeGIBaseColor);
+
+	static IConsoleVariable* CVarMobileProbeGI = nullptr;
+	if (!CVarMobileProbeGI)
+	{
+		CVarMobileProbeGI = IConsoleManager::Get().FindConsoleVariable(TEXT("r.Mobile.ProbeGI"));
+	}
+	if (!CVarMobileProbeGI || CVarMobileProbeGI->GetInt() == 0 || !InProxyDesc.bAffectDistanceFieldLighting)
+	{
+		return FColor(0, 0, 0, 0);
+	}
+
+	TArray<UMaterialInterface*> Materials;
+	InProxyDesc.GetUsedMaterials(Materials);
+	FLinearColor Sum = FLinearColor::Transparent;
+	int32 NumKnown = 0;
+	for (UMaterialInterface* Material : Materials)
+	{
+		const FLinearColor BaseColor = Material ? Material->GetProbeGIBaseColor() : FLinearColor::Transparent;
+		if (BaseColor.A > 0.0f)
+		{
+			Sum += BaseColor;
+			++NumKnown;
+		}
+	}
+	if (NumKnown == 0)
+	{
+		return FColor(0, 0, 0, 0);
+	}
+	FColor Encoded = (Sum / float(NumKnown)).ToFColorSRGB();
+	Encoded.A = 255;
+	return Encoded;
 }
 
