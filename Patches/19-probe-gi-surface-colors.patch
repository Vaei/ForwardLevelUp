+/**
+ * The base colour of every GPU Scene instance the global distance field object grid can name, which is every instance with a mesh
+ * distance field. Uploaded again only when a colour or the instance count changes. Returns how many entries the buffer holds.
+ */
+static uint32 UpdateInstanceBaseColors(FRDGBuilder& GraphBuilder, const FScene& Scene, FMobileProbeGISceneExtension& Extension, FRDGBufferSRVRef& OutColors)
+{
+	TRACE_CPUPROFILER_EVENT_SCOPE(MobileProbeGI::UpdateInstanceBaseColors);
+
+	const int32 NumInstances = Scene.GPUScene.GetNumInstances();
+	TArray<uint32, SceneRenderingAllocator> Colors;
+	Colors.SetNumZeroed(FMath::Max(NumInstances, 1));
+	for (const FPrimitiveAndInstance& Mapping : Scene.DistanceFieldSceneData.PrimitiveInstanceMapping)
+	{
+		const FPrimitiveSceneInfo* Primitive = Mapping.Primitive;
+		const int32 FirstInstance = Primitive ? Primitive->GetInstanceSceneDataOffset() : INDEX_NONE;
+		if (FirstInstance == INDEX_NONE)
+		{
+			continue;
+		}
+		// The same instance ID the distance field object buffer stores for the object grid
+		const int32 Instance = Primitive->Proxy->SupportsInstanceDataBuffer() ? FirstInstance + Mapping.InstanceIndex : FirstInstance;
+		if (Instance < NumInstances)
+		{
+			Colors[Instance] = Primitive->Proxy->GetProbeGIBaseColor().DWColor();
+		}
+	}
+
+	const bool bChanged = !Extension.InstanceBaseColorBuffer
+		|| Extension.InstanceBaseColors.Num() != Colors.Num()
+		|| FMemory::Memcmp(Extension.InstanceBaseColors.GetData(), Colors.GetData(), Colors.Num() * sizeof(uint32)) != 0;
+	FRDGBufferRef Buffer;
+	if (bChanged)
+	{
+		Extension.InstanceBaseColors = Colors;
+		Buffer = GraphBuilder.CreateBuffer(FRDGBufferDesc::CreateBufferDesc(sizeof(uint32), Colors.Num()), TEXT("MobileProbeGI.InstanceBaseColors"));
+		GraphBuilder.QueueBufferUpload(Buffer, Extension.InstanceBaseColors.GetData(), Extension.InstanceBaseColors.Num() * sizeof(uint32), ERDGInitialDataFlags::None);
+		Extension.InstanceBaseColorBuffer = GraphBuilder.ConvertToExternalBuffer(Buffer);
+	}
+	else
+	{
+		Buffer = GraphBuilder.RegisterExternalBuffer(Extension.InstanceBaseColorBuffer);
+	}
+	OutColors = GraphBuilder.CreateSRV(Buffer, PF_R32_UINT);
+	return uint32(Colors.Num());
+}
