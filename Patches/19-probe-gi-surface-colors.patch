@@ -0,0 +1,284 @@
+// Copyright (c) 2026 Jared Taylor.
+
+#include "Materials/MaterialInterface.h"
+
+#include "Materials/MaterialInstance.h"
+#include "ProfilingDebugging/CpuProfilerTrace.h"
+
+#if WITH_EDITORONLY_DATA
+#include "Engine/Texture.h"
+#include "ImageCore.h"
+#include "Materials/Material.h"
+#include "Materials/MaterialExpressionAdd.h"
+#include "Materials/MaterialExpressionConstant.h"
+#include "Materials/MaterialExpressionConstant2Vector.h"
+#include "Materials/MaterialExpressionConstant3Vector.h"
+#include "Materials/MaterialExpressionConstant4Vector.h"
+#include "Materials/MaterialExpressionLinearInterpolate.h"
+#include "Materials/MaterialExpressionMultiply.h"
+#include "Materials/MaterialExpressionReroute.h"
+#include "Materials/MaterialExpressionScalarParameter.h"
+#include "Materials/MaterialExpressionSubtract.h"
+#include "Materials/MaterialExpressionTextureObjectParameter.h"
+#include "Materials/MaterialExpressionTextureSample.h"
+#include "Materials/MaterialExpressionTextureSampleParameter.h"
+#include "Materials/MaterialExpressionVectorParameter.h"
+#include "Misc/ScopeLock.h"
+#include "UObject/ObjectKey.h"
+
+namespace MaterialProbeGIBaseColor
+{
+	/** Texture averages, keyed by texture and invalidated when its source changes. */
+	struct FTextureAverage
+	{
+		FGuid SourceId;
+		FLinearColor Average = FLinearColor::Transparent;
+	};
+	static TMap<FObjectKey, FTextureAverage> TextureAverages;
+	static FCriticalSection TextureAveragesLock;
+
+	/** Mean linear colour of a texture's source, from a downsized copy. Alpha 0 when the source is unavailable. */
+	static FLinearColor GetTextureAverage(UTexture* Texture)
+	{
+		TRACE_CPUPROFILER_EVENT_SCOPE(MaterialProbeGIBaseColor::GetTextureAverage);
+
+		if (!Texture || !Texture->Source.IsValid())
+		{
+			return FLinearColor::Transparent;
+		}
+
+		const FGuid SourceId = Texture->Source.GetId();
+		FScopeLock Lock(&TextureAveragesLock);
+		if (const FTextureAverage* Cached = TextureAverages.Find(FObjectKey(Texture)); Cached && Cached->SourceId == SourceId)
+		{
+			return Cached->Average;
+		}
+
+		FLinearColor Average = FLinearColor::Transparent;
+		FImage Image;
+		if (Texture->Source.GetMipImage(Image, 0))
+		{
+			FImageCore::ResizeImageInPlace(Image, FMath::Min(Image.SizeX, 64), FMath::Min(Image.SizeY, 64), ERawImageFormat::RGBA32F, EGammaSpace::Linear);
+			Average = FImageCore::ComputeImageLinearAverage(Image);
+			Average.A = 1.0f;
+		}
+		TextureAverages.Add(FObjectKey(Texture), { SourceId, Average });
+		return Average;
+	}
+
+	/** Folds the base colour graph into one average colour, for the expressions whose average follows from their inputs' averages. */
+	class FEvaluator
+	{
+	public:
+		explicit FEvaluator(UMaterialInterface* InParameterSource) : ParameterSource(InParameterSource) {}
+
+		bool Evaluate(const FExpressionInput& Input, float DefaultValue, FLinearColor& OutValue)
+		{
+			if (!Input.Expression)
+			{
+				OutValue = FLinearColor(DefaultValue, DefaultValue, DefaultValue, DefaultValue);
+				return true;
+			}
+			if (++Depth > 32)
+			{
+				return false;
+			}
+
+			FLinearColor Value;
+			const bool bResult = EvaluateExpression(Input.Expression, Input.OutputIndex, Value);
+			--Depth;
+			if (!bResult)
+			{
+				return false;
+			}
+
+			if (Input.Mask)
+			{
+				Value = ApplyMask(Value, Input.MaskR, Input.MaskG, Input.MaskB, Input.MaskA);
+			}
+			OutValue = Value;
+			return true;
+		}
+
+	private:
+		UMaterialInterface* ParameterSource;
+		int32 Depth = 0;
+
+		/** Masked channels in order; a single channel spreads to all four, as a scalar does. */
+		static FLinearColor ApplyMask(const FLinearColor& Value, int32 MaskR, int32 MaskG, int32 MaskB, int32 MaskA)
+		{
+			float Channels[4];
+			int32 NumChannels = 0;
+			if (MaskR) { Channels[NumChannels++] = Value.R; }
+			if (MaskG) { Channels[NumChannels++] = Value.G; }
+			if (MaskB) { Channels[NumChannels++] = Value.B; }
+			if (MaskA) { Channels[NumChannels++] = Value.A; }
+			if (NumChannels == 1)
+			{
+				return FLinearColor(Channels[0], Channels[0], Channels[0], Channels[0]);
+			}
+			FLinearColor Result = FLinearColor::Black;
+			for (int32 Index = 0; Index < NumChannels; ++Index)
+			{
+				Result.Component(Index) = Channels[Index];
+			}
+			return Result;
+		}
+
+		bool EvaluateExpression(UMaterialExpression* Expression, int32 OutputIndex, FLinearColor& OutValue)
+		{
+			FLinearColor Value;
+			if (!EvaluateUnmasked(Expression, Value))
+			{
+				return false;
+			}
+			const TArray<FExpressionOutput>& Outputs = Expression->GetOutputs();
+			if (Outputs.IsValidIndex(OutputIndex) && Outputs[OutputIndex].Mask)
+			{
+				const FExpressionOutput& Output = Outputs[OutputIndex];
+				Value = ApplyMask(Value, Output.MaskR, Output.MaskG, Output.MaskB, Output.MaskA);
+			}
+			OutValue = Value;
+			return true;
+		}
+
+		UTexture* GetTexture(UMaterialExpressionTextureSample* Sample)
+		{
+			UTexture* Texture = Sample->Texture;
+			FName ParameterName;
+			if (UMaterialExpressionTextureSampleParameter* Parameter = Cast<UMaterialExpressionTextureSampleParameter>(Sample))
+			{
+				ParameterName = Parameter->ParameterName;
+			}
+			else if (UMaterialExpressionTextureBase* Object = Cast<UMaterialExpressionTextureBase>(Sample->TextureObject.Expression))
+			{
+				Texture = Object->Texture;
+				if (UMaterialExpressionTextureObjectParameter* ObjectParameter = Cast<UMaterialExpressionTextureObjectParameter>(Object))
+				{
+					ParameterName = ObjectParameter->ParameterName;
+				}
+			}
+			else if (Sample->TextureObject.Expression)
+			{
+				return nullptr;
+			}
+
+			UTexture* Override = nullptr;
+			if (!ParameterName.IsNone() && ParameterSource->GetTextureParameterValue(FHashedMaterialParameterInfo(ParameterName), Override) && Override)
+			{
+				Texture = Override;
+			}
+			return Texture;
+		}
+
+		bool EvaluateUnmasked(UMaterialExpression* Expression, FLinearColor& OutValue)
+		{
+			if (const UMaterialExpressionConstant* Constant = Cast<UMaterialExpressionConstant>(Expression))
+			{
+				OutValue = FLinearColor(Constant->R, Constant->R, Constant->R, Constant->R);
+				return true;
+			}
+			if (const UMaterialExpressionConstant2Vector* Constant2 = Cast<UMaterialExpressionConstant2Vector>(Expression))
+			{
+				OutValue = FLinearColor(Constant2->R, Constant2->G, 0.0f, 0.0f);
+				return true;
+			}
+			if (const UMaterialExpressionConstant3Vector* Constant3 = Cast<UMaterialExpressionConstant3Vector>(Expression))
+			{
+				OutValue = Constant3->Constant;
+				return true;
+			}
+			if (const UMaterialExpressionConstant4Vector* Constant4 = Cast<UMaterialExpressionConstant4Vector>(Expression))
+			{
+				OutValue = Constant4->Constant;
+				return true;
+			}
+			if (const UMaterialExpressionVectorParameter* VectorParameter = Cast<UMaterialExpressionVectorParameter>(Expression))
+			{
+				OutValue = VectorParameter->DefaultValue;
+				ParameterSource->GetVectorParameterValue(FHashedMaterialParameterInfo(VectorParameter->ParameterName), OutValue);
+				return true;
+			}
+			if (const UMaterialExpressionScalarParameter* ScalarParameter = Cast<UMaterialExpressionScalarParameter>(Expression))
+			{
+				float Value = ScalarParameter->DefaultValue;
+				ParameterSource->GetScalarParameterValue(FHashedMaterialParameterInfo(ScalarParameter->ParameterName), Value);
+				OutValue = FLinearColor(Value, Value, Value, Value);
+				return true;
+			}
+			if (UMaterialExpressionTextureSample* Sample = Cast<UMaterialExpressionTextureSample>(Expression))
+			{
+				OutValue = GetTextureAverage(GetTexture(Sample));
+				return OutValue.A > 0.0f;
+			}
+			if (UMaterialExpressionMultiply* Multiply = Cast<UMaterialExpressionMultiply>(Expression))
+			{
+				FLinearColor A, B;
+				return Evaluate(Multiply->A, Multiply->ConstA, A) && Evaluate(Multiply->B, Multiply->ConstB, B) && (OutValue = A * B, true);
+			}
+			if (UMaterialExpressionAdd* Add = Cast<UMaterialExpressionAdd>(Expression))
+			{
+				FLinearColor A, B;
+				return Evaluate(Add->A, Add->ConstA, A) && Evaluate(Add->B, Add->ConstB, B) && (OutValue = A + B, true);
+			}
+			if (UMaterialExpressionSubtract* Subtract = Cast<UMaterialExpressionSubtract>(Expression))
+			{
+				FLinearColor A, B;
+				return Evaluate(Subtract->A, Subtract->ConstA, A) && Evaluate(Subtract->B, Subtract->ConstB, B) && (OutValue = A - B, true);
+			}
+			if (UMaterialExpressionLinearInterpolate* Lerp = Cast<UMaterialExpressionLinearInterpolate>(Expression))
+			{
+				FLinearColor A, B, Alpha;
+				return Evaluate(Lerp->A, Lerp->ConstA, A) && Evaluate(Lerp->B, Lerp->ConstB, B) && Evaluate(Lerp->Alpha, Lerp->ConstAlpha, Alpha)
+					&& (OutValue = A + (B - A) * Alpha.R, true);
+			}
+			if (UMaterialExpressionReroute* Reroute = Cast<UMaterialExpressionReroute>(Expression))
+			{
+				return Evaluate(Reroute->Input, 0.0f, OutValue);
+			}
+			return false;
+		}
+	};
+
+	static FLinearColor Compute(UMaterialInterface* Material)
+	{
+		TRACE_CPUPROFILER_EVENT_SCOPE(MaterialProbeGIBaseColor::Compute);
+
+		UMaterial* BaseMaterial = Material->GetMaterial();
+		const UMaterialEditorOnlyData* EditorOnly = BaseMaterial ? BaseMaterial->GetEditorOnlyData() : nullptr;
+		if (!EditorOnly || BaseMaterial->bUseMaterialAttributes)
+		{
+			return FLinearColor::Transparent;
+		}
+
+		FLinearColor BaseColor;
+		if (!FEvaluator(Material).Evaluate(EditorOnly->BaseColor, 0.0f, BaseColor))
+		{
+			return FLinearColor::Transparent;
+		}
+		BaseColor = FLinearColor(FMath::Clamp(BaseColor.R, 0.0f, 1.0f), FMath::Clamp(BaseColor.G, 0.0f, 1.0f), FMath::Clamp(BaseColor.B, 0.0f, 1.0f), 1.0f);
+		return BaseColor;
+	}
+}
+#endif // WITH_EDITORONLY_DATA
+
+FLinearColor UMaterialInterface::GetProbeGIBaseColor()
+{
+#if WITH_EDITORONLY_DATA
+	// Evaluating reads the material graph and texture sources, which only the game thread may do
+	if (!bProbeGIBaseColorValid && IsInGameThread())
+	{
+		ProbeGIBaseColor = MaterialProbeGIBaseColor::Compute(this);
+		bProbeGIBaseColorValid = true;
+	}
+#endif
+	// Dynamic instances are never saved, so cooked builds fall back to the colour saved with their parent
+	if (ProbeGIBaseColor.A == 0.0f)
+	{
+		if (UMaterialInstance* Instance = Cast<UMaterialInstance>(this); Instance && Instance->Parent)
+		{
+			return Instance->Parent->GetProbeGIBaseColor();
+		}
+	}
+	return ProbeGIBaseColor;
+}
