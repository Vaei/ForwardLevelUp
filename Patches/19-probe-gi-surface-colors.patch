+uint NumInstanceBaseColors;
+
+/** Base colour of the mesh nearest a hit, from the instances the global distance field object grid lists for its cell, nearest first. */
+float3 GetHitBaseColor(float3 HitPosition, float3 HitNormal, uint ClipmapIndex)
+{
+	if (GlobalDistanceFieldPageObjectGridBufferSize == 0)
+	{
+		return DefaultAlbedo;
+	}
+
+	// The cell just outside the surface, where the grid ranks the meshes by distance as Lumen's surface cache lookup does
+	const float VoxelExtent = GlobalVolumeTranslatedCenterAndExtent[ClipmapIndex].w * GlobalVolumeTexelSize;
+	const float3 ClipmapVolumeUV = ComputeGlobalUV(HitPosition + HitNormal * VoxelExtent, ClipmapIndex);
+	const FGlobalDistanceFieldPage Page = GetGlobalDistanceFieldPage(ClipmapVolumeUV, ClipmapIndex);
+	if (!Page.bValid)
+	{
+		return DefaultAlbedo;
+	}
+
+	const float3 PageTableCoord = saturate(ClipmapVolumeUV) * GlobalDistanceFieldClipmapSizeInPages;
+	const uint3 CellCoordInPage = frac(PageTableCoord) * DISTANCE_FIELD_OBJECT_GRID_PAGE_RESOLUTION;
+	const uint CellIndex = DISTANCE_FIELD_OBJECT_GRID_PAGE_STRIDE * Page.PageIndex + ZOrder3DEncode(CellCoordInPage, log2(DISTANCE_FIELD_OBJECT_GRID_PAGE_RESOLUTION));
+	if (CellIndex >= GlobalDistanceFieldPageObjectGridBufferSize)
+	{
+		return DefaultAlbedo;
+	}
+
+	const uint4 Cell = GlobalDistanceFieldPageObjectGridBuffer[CellIndex];
+	for (uint IndexInCell = 0; IndexInCell < DISTANCE_FIELD_OBJECT_GRID_CELL_SIZE; ++IndexInCell)
+	{
+		const FObjectGridCellIndex Entry = UnpackObjectGridCellIndex(Cell[IndexInCell]);
+		if (!Entry.bValid)
+		{
+			break;
+		}
+		const uint Packed = Entry.GPUSceneInstanceIndex < NumInstanceBaseColors ? InstanceBaseColors[Entry.GPUSceneInstanceIndex] : 0;
+		// Alpha is zero for meshes whose material colour is unknown; the next nearest mesh may know better
+		if ((Packed >> 24) != 0)
+		{
+			const float3 Encoded = float3((Packed >> 16) & 0xFF, (Packed >> 8) & 0xFF, Packed & 0xFF) / 255.0f;
+			return sRGBToLinear(Encoded);
+		}
+	}
+	return DefaultAlbedo;
+}
