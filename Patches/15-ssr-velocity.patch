--- /dev/null
+++ b/Engine/Shaders/Private/MobileMSAAVelocityResolve.usf
@@ -0,0 +1,26 @@
+// Copyright (c) 2026 Jared Taylor.
+
+#include "Common.ush"
+
+Texture2DMS<float4> VelocityMS;
+RWTexture2D<float4> RWVelocity;
+int2 Extent;
+uint NumSamples;
+
+[numthreads(GROUP_SIZE, GROUP_SIZE, 1)]
+void MainCS(uint2 DispatchThreadId : SV_DispatchThreadID)
+{
+	if (any(int2(DispatchThreadId) >= Extent))
+	{
+		return;
+	}
+
+	// Encoded velocity is zero where the camera alone moved, so averaging samples would corrupt a mover's edge.
+	// Keep the first sample that carries object motion.
+	float4 Velocity = VelocityMS.Load(DispatchThreadId, 0);
+	for (uint SampleIndex = 1; SampleIndex < NumSamples && Velocity.x <= 0.0; ++SampleIndex)
+	{
+		Velocity = VelocityMS.Load(DispatchThreadId, SampleIndex);
+	}
+	RWVelocity[DispatchThreadId] = Velocity;
+}
