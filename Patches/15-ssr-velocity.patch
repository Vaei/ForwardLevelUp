+class FMobileMSAAVelocityResolveCS : public FGlobalShader
+{
+	DECLARE_GLOBAL_SHADER(FMobileMSAAVelocityResolveCS);
+	SHADER_USE_PARAMETER_STRUCT(FMobileMSAAVelocityResolveCS, FGlobalShader);
+
+	BEGIN_SHADER_PARAMETER_STRUCT(FParameters, )
+		SHADER_PARAMETER_RDG_TEXTURE(Texture2DMS<float4>, VelocityMS)
+		SHADER_PARAMETER_RDG_TEXTURE_UAV(RWTexture2D<float4>, RWVelocity)
+		SHADER_PARAMETER(FIntPoint, Extent)
+		SHADER_PARAMETER(uint32, NumSamples)
+	END_SHADER_PARAMETER_STRUCT()
+
+	static constexpr int32 GroupSize = 8;
+
+	static bool ShouldCompilePermutation(const FGlobalShaderPermutationParameters& Parameters)
+	{
+		return MobileSSRUsesVelocity(Parameters.Platform);
+	}
+
+	static void ModifyCompilationEnvironment(const FGlobalShaderPermutationParameters& Parameters, FShaderCompilerEnvironment& OutEnvironment)
+	{
+		FGlobalShader::ModifyCompilationEnvironment(Parameters, OutEnvironment);
+		OutEnvironment.SetDefine(TEXT("GROUP_SIZE"), GroupSize);
+	}
+};
+
+IMPLEMENT_GLOBAL_SHADER(FMobileMSAAVelocityResolveCS, "/Engine/Private/MobileMSAAVelocityResolve.usf", "MainCS", SF_Compute);
+
+void FMobileSceneRenderer::RenderMSAAVelocities(FRDGBuilder& GraphBuilder, FSceneTextures& SceneTextures)
+{
+	TRACE_CPUPROFILER_EVENT_SCOPE(MobileSceneRenderer::RenderMSAAVelocities);
+
+	RDG_EVENT_SCOPE(GraphBuilder, "MSAAVelocities");
+
+	const uint32 NumSamples = SceneTextures.Depth.Target->Desc.NumSamples;
+	FRDGTextureDesc MSAADesc = SceneTextures.Velocity->Desc;
+	MSAADesc.NumSamples = NumSamples;
+	MSAADesc.Flags = TexCreate_RenderTargetable | TexCreate_ShaderResource;
+	FRDGTextureRef VelocityMS = GraphBuilder.CreateTexture(MSAADesc, TEXT("MobileVelocityMS"));
+
+	RenderVelocities(GraphBuilder, Views, SceneTextures, EVelocityPass::Opaque, /*bForceVelocity*/ true, /*bBindRenderTarget*/ true, VelocityMS, SceneTextures.Depth.Target);
+
+	FMobileMSAAVelocityResolveCS::FParameters* PassParameters = GraphBuilder.AllocParameters<FMobileMSAAVelocityResolveCS::FParameters>();
+	PassParameters->VelocityMS = VelocityMS;
+	PassParameters->RWVelocity = GraphBuilder.CreateUAV(SceneTextures.Velocity);
+	PassParameters->Extent = SceneTextures.Velocity->Desc.Extent;
+	PassParameters->NumSamples = NumSamples;
+
+	TShaderMapRef<FMobileMSAAVelocityResolveCS> ComputeShader(GetGlobalShaderMap(FeatureLevel));
+	FComputeShaderUtils::AddPass(
+		GraphBuilder,
+		RDG_EVENT_NAME("ResolveVelocity %dx%d", PassParameters->Extent.X, PassParameters->Extent.Y),
+		ComputeShader,
+		PassParameters,
+		FComputeShaderUtils::GetGroupCount(PassParameters->Extent, FMobileMSAAVelocityResolveCS::GroupSize));
+}
