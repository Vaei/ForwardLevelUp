+/**
+ * Screen-space shadow mask and AO are computed from resolved depth, so under MSAA they hold the nearest surface's value.
+ * A fragment of another surface at that pixel (an MSAA edge sample) uses the neighbouring texel whose resolved depth matches its own.
+ */
+float2 GetMSAAEdgeAwareBufferUV(float4 SvPosition, float2 BufferUV)
+{
+#if !MOBILE_MULTI_VIEW
+	BRANCH
+	if (MobileBasePass.bMSAAEdgeAwareFetch != 0)
+	{
+		const int2 Pixel = int2(SvPosition.xy);
+		const float FragmentDepth = ConvertFromDeviceZ(SvPosition.z);
+		const float Threshold = FragmentDepth * MobileBasePass.MSAAEdgeDepthThreshold;
+
+		float BestError = abs(ConvertFromDeviceZ(MobileBasePass.MSAAResolvedDepthTexture.Load(int3(Pixel, 0)).r) - FragmentDepth);
+		int2 BestOffset = int2(0, 0);
+
+		BRANCH
+		if (BestError > Threshold)
+		{
+			const int2 Offsets[4] = { int2(-1, 0), int2(1, 0), int2(0, -1), int2(0, 1) };
+			UNROLL
+			for (int Index = 0; Index < 4; ++Index)
+			{
+				const float Error = abs(ConvertFromDeviceZ(MobileBasePass.MSAAResolvedDepthTexture.Load(int3(Pixel + Offsets[Index], 0)).r) - FragmentDepth);
+				if (Error < BestError)
+				{
+					BestError = Error;
+					BestOffset = Offsets[Index];
+				}
+			}
+		}
+		return BufferUV + float2(BestOffset) * View.BufferSizeAndInvSize.zw;
+	}
+#endif
+	return BufferUV;
+}
