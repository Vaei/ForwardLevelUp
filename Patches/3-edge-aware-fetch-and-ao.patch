-	half4 ScreenSpaceShadowMaskSample = SampleScreenSpaceShadowMask(BufferUV, EyeIndex);
+	const float2 ScreenSpaceBufferUV = GetMSAAEdgeAwareBufferUV(SvPosition, BufferUV);
+	half4 ScreenSpaceShadowMaskSample = SampleScreenSpaceShadowMask(ScreenSpaceBufferUV, EyeIndex);
 
 	half MaterialAO = GetMaterialAmbientOcclusion(PixelMaterialInputs);
 #if APPLY_AO
 	{
+	#if MOBILE_MULTI_VIEW
 		half GatheredAmbientOcclusion = ScreenSpaceShadowMaskSample.a;
+	#else
+		// Mobile SSAO renders into its own texture; nothing writes the shadow mask's alpha in forward
+		half GatheredAmbientOcclusion = Texture2DSampleLevel(MobileBasePass.AmbientOcclusionTexture, MobileBasePass.AmbientOcclusionSampler, ScreenSpaceBufferUV, 0).r;
+	#endif
 		#if ALLOW_STATIC_LIGHTING
 			GatheredAmbientOcclusion = lerp(1.0, GatheredAmbientOcclusion, MobileBasePass.AmbientOcclusionStaticFraction);
 		#endif
