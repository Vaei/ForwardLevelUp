diff --git a/Engine/Shaders/Private/MobileClusteredDecalBake.usf b/Engine/Shaders/Private/MobileClusteredDecalBake.usf
new file mode 100644
index 000000000000..2118c213df68
--- /dev/null
+++ b/Engine/Shaders/Private/MobileClusteredDecalBake.usf
@@ -0,0 +1,60 @@
+// Copyright (c) 2026 Jared Taylor.
+
+#include "Common.ush"
+
+#define MobileSceneTextures DecalPass.MobileSceneTextures
+#define EyeAdaptationStruct DecalPass
+#define SubstrateStruct DecalPass.SubstratePublic
+
+// Read by the material template for decals, as DeferredDecal.usf declares them
+float4 DecalPositionHigh;
+float4x4 DecalToWorld;
+float3 DecalToWorldInvScale;
+float3 DecalOrientation;
+float2 DecalParams;
+float4 DecalColorParam;
+
+/** xy: the tile's first pixel in the atlas, zw: one over its size. */
+float4 BakeTileRect;
+float4x4 BakeDecalToTranslatedWorld;
+
+#define DECAL_PRIMITIVE 1
+#include "/Engine/Generated/Material.ush"
+
+/** The material across the decal's plane, through its centre: UVs as the decal pass gives them, with no fading along the projection. */
+void MainPS(
+	float4 SvPosition : SV_POSITION,
+	out float4 OutBaseColor : SV_Target0,
+	out float4 OutNormal : SV_Target1,
+	out float4 OutRoughness : SV_Target2)
+{
+	const float2 DecalUVs = (SvPosition.xy - BakeTileRect.xy) * BakeTileRect.zw;
+	const float3 OSPosition = float3(0, DecalUVs.y * 2 - 1, DecalUVs.x * 2 - 1);
+	const float3 TranslatedWorldPosition = mul(float4(OSPosition, 1), BakeDecalToTranslatedWorld).xyz;
+
+	FMaterialPixelParameters MaterialParameters = MakeInitializedMaterialPixelParameters();
+#if NUM_MATERIAL_TEXCOORDS
+	for (int CoordinateIndex = 0; CoordinateIndex < NUM_MATERIAL_TEXCOORDS; CoordinateIndex++)
+	{
+		MaterialParameters.TexCoords[CoordinateIndex] = DecalUVs;
+	}
+#endif
+	MaterialParameters.TwoSidedSign = 1;
+	MaterialParameters.VertexColor = 1;
+	// Looking down the projection, as a receiver facing the decal would
+	MaterialParameters.CameraVector = -normalize(DecalOrientation);
+	MaterialParameters.SvPosition = float4(SvPosition.xy, 0.5, 1);
+	MaterialParameters.ScreenPosition = SvPositionToResolvedScreenPosition(MaterialParameters.SvPosition);
+	MaterialParameters.LightVector = float3(DecalUVs, 0.5);
+	MaterialParameters.AbsoluteWorldPosition = MaterialParameters.WorldPosition_NoOffsets = DFFastSubtract(TranslatedWorldPosition, PrimaryView.PreViewTranslation);
+	MaterialParameters.WorldPosition_CamRelative = MaterialParameters.WorldPosition_NoOffsets_CamRelative = TranslatedWorldPosition;
+	MaterialParameters.LWCData = MakeMaterialLWCData(MaterialParameters);
+
+	FPixelMaterialInputs PixelMaterialInputs;
+	CalcPixelMaterialInputs(MaterialParameters, PixelMaterialInputs);
+
+	const float Opacity = saturate(GetMaterialOpacity(PixelMaterialInputs));
+	OutBaseColor = float4(saturate(GetMaterialBaseColor(PixelMaterialInputs)), Opacity);
+	OutNormal = float4(normalize(MaterialParameters.WorldNormal) * 0.5 + 0.5, Opacity);
+	OutRoughness = float4(saturate(GetMaterialMetallic(PixelMaterialInputs)), saturate(GetMaterialSpecular(PixelMaterialInputs)), saturate(GetMaterialRoughness(PixelMaterialInputs)), Opacity);
+}
diff --git a/Engine/Shaders/Private/MobileClusteredDecals.ush b/Engine/Shaders/Private/MobileClusteredDecals.ush
new file mode 100644
index 000000000000..56afb1f31e6a
--- /dev/null
+++ b/Engine/Shaders/Private/MobileClusteredDecals.ush
@@ -0,0 +1,83 @@
+// Copyright (c) 2026 Jared Taylor.
+
+#pragma once
+
+#include "DBufferDecalShared.ush"
+
+/**
+ * Composites the decals listed for this pixel's screen tile, in sort order, the way the DBuffer passes would have blended them,
+ * so the result applies with ApplyDBufferData. Returns false when no decal covers the pixel.
+ */
+bool GetMobileClusteredDecalData(float2 SvPositionXY, float3 TranslatedWorldPosition, uint ResponseMask, out FDBufferData OutData)
+{
+	OutData.PreMulColor = 0;
+	OutData.ColorOpacity = 1;
+	OutData.PreMulWorldNormal = 0;
+	OutData.NormalOpacity = 1;
+	OutData.PreMulRoughness = 0;
+	OutData.PreMulMetallic = 0;
+	OutData.PreMulSpecular = 0;
+	OutData.RoughnessOpacity = 1;
+
+	const uint2 Tile = uint2(SvPositionXY - ResolvedView.ViewRectMin.xy) >> MobileBasePass.ClusteredDecalTileShift;
+	if (any(Tile >= uint2(MobileBasePass.ClusteredDecalTileCount)))
+	{
+		return false;
+	}
+
+	const uint TileOffset = (Tile.y * MobileBasePass.ClusteredDecalTileCount.x + Tile.x) * MobileBasePass.ClusteredDecalTileStride;
+	const uint NumDecals = MobileBasePass.ClusteredDecalTiles[TileOffset];
+	bool bAnyDecal = false;
+
+	LOOP
+	for (uint ListIndex = 0; ListIndex < NumDecals; ListIndex++)
+	{
+		const uint DecalOffset = MobileBasePass.ClusteredDecalTiles[TileOffset + 1 + ListIndex] * 5;
+		const float4 TranslatedPosition = float4(TranslatedWorldPosition, 1);
+		const float3 DecalPosition = float3(
+			dot(TranslatedPosition, MobileBasePass.ClusteredDecalData[DecalOffset + 0]),
+			dot(TranslatedPosition, MobileBasePass.ClusteredDecalData[DecalOffset + 1]),
+			dot(TranslatedPosition, MobileBasePass.ClusteredDecalData[DecalOffset + 2]));
+		if (any(abs(DecalPosition) > 1))
+		{
+			continue;
+		}
+
+		const float4 AtlasScaleBias = MobileBasePass.ClusteredDecalData[DecalOffset + 3];
+		const float4 Params = MobileBasePass.ClusteredDecalData[DecalOffset + 4];
+		const float2 AtlasUV = (DecalPosition.zy * 0.5 + 0.5) * AtlasScaleBias.xy + AtlasScaleBias.zw;
+		// Fades towards both ends of the projection, as the decal pass does
+		const float Fade = saturate(4 - 4 * abs(DecalPosition.x)) * Params.x;
+		const uint WriteMask = (uint)Params.y & ResponseMask;
+
+		BRANCH
+		if (WriteMask & 0x1)
+		{
+			const float4 BaseColor = Texture2DSampleLevel(MobileBasePass.ClusteredDecalAtlasA, MobileBasePass.ClusteredDecalAtlasSampler, AtlasUV, 0);
+			const float Alpha = BaseColor.a * Fade;
+			OutData.PreMulColor = OutData.PreMulColor * (1 - Alpha) + BaseColor.rgb * Alpha;
+			OutData.ColorOpacity *= 1 - Alpha;
+		}
+		BRANCH
+		if (WriteMask & 0x2)
+		{
+			const float4 Normal = Texture2DSampleLevel(MobileBasePass.ClusteredDecalAtlasB, MobileBasePass.ClusteredDecalAtlasSampler, AtlasUV, 0);
+			const float Alpha = Normal.a * Fade;
+			OutData.PreMulWorldNormal = OutData.PreMulWorldNormal * (1 - Alpha) + (Normal.rgb * 2 - 1) * Alpha;
+			OutData.NormalOpacity *= 1 - Alpha;
+		}
+		BRANCH
+		if (WriteMask & 0x4)
+		{
+			const float4 Surface = Texture2DSampleLevel(MobileBasePass.ClusteredDecalAtlasC, MobileBasePass.ClusteredDecalAtlasSampler, AtlasUV, 0);
+			const float Alpha = Surface.a * Fade;
+			OutData.PreMulMetallic = OutData.PreMulMetallic * (1 - Alpha) + Surface.r * Alpha;
+			OutData.PreMulSpecular = OutData.PreMulSpecular * (1 - Alpha) + Surface.g * Alpha;
+			OutData.PreMulRoughness = OutData.PreMulRoughness * (1 - Alpha) + Surface.b * Alpha;
+			OutData.RoughnessOpacity *= 1 - Alpha;
+		}
+		bAnyDecal = true;
+	}
+
+	return bAnyDecal;
+}
