+/**
+ * r.Mobile.ClusteredDecals: the forward base pass applies deferred decals itself, from screen tile lists, before lighting.
+ * Each decal's material is baked once into a shared atlas tile, so its base colour, normal and roughness change the surface
+ * that every light then shades, at every MSAA sample.
+ */
+bool IsMobileClusteredDecalsEnabled(EShaderPlatform Platform);
+
+/** Decals whose material writes base colour, normal or roughness and nothing else; the rest keep drawing over scene colour. */
+bool CanMobileDecalBeClustered(const FDecalBlendDesc& BlendDesc);
+
+/** One view's decals for the base pass. */
+struct FMobileClusteredDecalViewData
+{
+	FRDGBufferSRVRef DecalData = nullptr;
+	FRDGBufferSRVRef TileData = nullptr;
+	FRDGTextureRef AtlasA = nullptr;
+	FRDGTextureRef AtlasB = nullptr;
+	FRDGTextureRef AtlasC = nullptr;
+	FIntPoint TileCount = FIntPoint::ZeroValue;
+	uint32 TileSizeShift = 0;
+	uint32 TileStride = 0;
+	uint32 NumDecals = 0;
+
+	/** Decals the base pass applies, which the scene colour decal pass skips. */
+	TSet<const FVisibleDecal*> Decals;
+};
+
+/** Bakes any decals new to the atlas and builds the view's tile lists. Leaves View.MobileClusteredDecals null when there are none. */
+void BuildMobileClusteredDecals(FRDGBuilder& GraphBuilder, FScene* Scene, FViewInfo& View, TConstArrayView<const FVisibleDecal*> RelevantDecals, const FSceneTextures& SceneTextures);
+
+/** Binds the view's decals into the base pass, or empty ones. */
+void SetMobileClusteredDecalParameters(FRDGBuilder& GraphBuilder, const FMobileClusteredDecalViewData* ViewData, FMobileBasePassUniformParameters& Parameters);
