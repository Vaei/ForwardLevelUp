diff --git a/Engine/Source/Runtime/Renderer/Private/MobileClusteredDecals.cpp b/Engine/Source/Runtime/Renderer/Private/MobileClusteredDecals.cpp
new file mode 100644
index 000000000000..fa1fe02bea33
--- /dev/null
+++ b/Engine/Source/Runtime/Renderer/Private/MobileClusteredDecals.cpp
@@ -0,0 +1,504 @@
+// Copyright (c) 2026 Jared Taylor.
+
+#include "MobileClusteredDecals.h"
+#include "CompositionLighting/PostProcessDeferredDecals.h"
+#include "DataDrivenShaderPlatformInfo.h"
+#include "DecalRenderingCommon.h"
+#include "DecalRenderingShared.h"
+#include "MaterialShader.h"
+#include "MaterialShared.h"
+#include "Materials/MaterialRenderProxy.h"
+#include "MobileBasePassRendering.h"
+#include "PixelShaderUtils.h"
+#include "ProfilingDebugging/CpuProfilerTrace.h"
+#include "RenderGraphUtils.h"
+#include "SceneExtensions.h"
+#include "ScenePrivate.h"
+#include "SceneRendering.h"
+#include "SceneTextures.h"
+#include "SystemTextures.h"
+
+static TAutoConsoleVariable<int32> CVarMobileClusteredDecals(
+	TEXT("r.Mobile.ClusteredDecals"),
+	0,
+	TEXT("Mobile forward applies deferred decals in the base pass from screen tile lists, before lighting, instead of drawing them over scene colour afterwards. ")
+	TEXT("Decal materials that write base colour, normal or roughness are baked once into an atlas; emissive, modulate and alpha composite decals keep the stock path. ")
+	TEXT("Read only, recompiles materials."),
+	ECVF_ReadOnly | ECVF_RenderThreadSafe);
+
+static TAutoConsoleVariable<int32> CVarMobileClusteredDecalsAtlasSize(
+	TEXT("r.Mobile.ClusteredDecals.AtlasSize"),
+	2048,
+	TEXT("Texels along each side of the decal atlas. Holds (AtlasSize / TileSize) squared decals."),
+	ECVF_Scalability | ECVF_RenderThreadSafe);
+
+static TAutoConsoleVariable<int32> CVarMobileClusteredDecalsTileSize(
+	TEXT("r.Mobile.ClusteredDecals.TileSize"),
+	256,
+	TEXT("Texels along each side of one decal's atlas tile."),
+	ECVF_Scalability | ECVF_RenderThreadSafe);
+
+static TAutoConsoleVariable<int32> CVarMobileClusteredDecalsScreenTileShift(
+	TEXT("r.Mobile.ClusteredDecals.ScreenTileShift"),
+	6,
+	TEXT("Screen tiles are (1 << ScreenTileShift) pixels on a side."),
+	ECVF_Scalability | ECVF_RenderThreadSafe);
+
+static TAutoConsoleVariable<int32> CVarMobileClusteredDecalsMaxPerTile(
+	TEXT("r.Mobile.ClusteredDecals.MaxPerTile"),
+	8,
+	TEXT("Most decals one screen tile applies. Later decals in sort order are dropped from a full tile."),
+	ECVF_Scalability | ECVF_RenderThreadSafe);
+
+static TAutoConsoleVariable<int32> CVarMobileClusteredDecalsRebakeEveryFrame(
+	TEXT("r.Mobile.ClusteredDecals.RebakeEveryFrame"),
+	0,
+	TEXT("Bakes every decal each frame rather than only when it changes, for decal materials animated by time."),
+	ECVF_Scalability | ECVF_RenderThreadSafe);
+
+DECLARE_GPU_STAT_NAMED(MobileClusteredDecals, TEXT("Clustered Decals"));
+
+bool IsMobileClusteredDecalsEnabled(EShaderPlatform Platform)
+{
+	return IsMobilePlatform(Platform)
+		&& !IsMobileDeferredShadingEnabled(Platform)
+		&& !IsUsingDBuffers(Platform)
+		&& !Substrate::IsSubstrateEnabled()
+		&& CVarMobileClusteredDecals.GetValueOnAnyThread() != 0;
+}
+
+bool CanMobileDecalBeClustered(const FDecalBlendDesc& BlendDesc)
+{
+	return !IsModulateBlendMode((EBlendMode)BlendDesc.BlendMode)
+		&& !IsAlphaCompositeBlendMode((EBlendMode)BlendDesc.BlendMode)
+		&& !BlendDesc.bWriteEmissive
+		&& (BlendDesc.bWriteBaseColor || BlendDesc.bWriteNormal || BlendDesc.bWriteRoughnessSpecularMetallic);
+}
+
+/** Evaluates a decal material over its own UV square into one atlas tile: base colour, world normal, and metallic, specular, roughness. */
+class FMobileClusteredDecalBakePS : public FMaterialShader
+{
+	DECLARE_SHADER_TYPE(FMobileClusteredDecalBakePS, Material);
+
+public:
+	static bool ShouldCompilePermutation(const FMaterialShaderPermutationParameters& Parameters)
+	{
+		return Parameters.MaterialParameters.MaterialDomain == MD_DeferredDecal
+			&& IsMobileClusteredDecalsEnabled(Parameters.Platform)
+			&& CanMobileDecalBeClustered(DecalRendering::ComputeDecalBlendDesc(Parameters.Platform, Parameters.MaterialParameters));
+	}
+
+	static void ModifyCompilationEnvironment(const FMaterialShaderPermutationParameters& Parameters, FShaderCompilerEnvironment& OutEnvironment)
+	{
+		FMaterialShader::ModifyCompilationEnvironment(Parameters, OutEnvironment);
+		DecalRendering::ModifyCompilationEnvironment(Parameters.Platform, DecalRendering::ComputeDecalBlendDesc(Parameters.Platform, Parameters.MaterialParameters), EDecalRenderStage::Mobile, OutEnvironment);
+	}
+
+	FMobileClusteredDecalBakePS() {}
+	FMobileClusteredDecalBakePS(const ShaderMetaType::CompiledShaderInitializerType& Initializer)
+		: FMaterialShader(Initializer)
+	{
+		DecalPositionHigh.Bind(Initializer.ParameterMap, TEXT("DecalPositionHigh"));
+		DecalToWorld.Bind(Initializer.ParameterMap, TEXT("DecalToWorld"));
+		DecalToWorldInvScale.Bind(Initializer.ParameterMap, TEXT("DecalToWorldInvScale"));
+		DecalOrientation.Bind(Initializer.ParameterMap, TEXT("DecalOrientation"));
+		DecalParams.Bind(Initializer.ParameterMap, TEXT("DecalParams"));
+		DecalColorParam.Bind(Initializer.ParameterMap, TEXT("DecalColorParam"));
+		BakeTileRect.Bind(Initializer.ParameterMap, TEXT("BakeTileRect"));
+		BakeDecalToTranslatedWorld.Bind(Initializer.ParameterMap, TEXT("BakeDecalToTranslatedWorld"));
+	}
+
+	void SetParameters(FRHIBatchedShaderParameters& BatchedParameters, const FViewInfo& View, const FVisibleDecal& VisibleDecal, const FMaterialRenderProxy* MaterialProxy, const FMaterial* MaterialResource, const FVector4f& TileRect, float LifetimeAlpha)
+	{
+		auto& PrimitivePS = GetUniformBufferParameter<FPrimitiveUniformShaderParameters>();
+		SetUniformBufferParameter(BatchedParameters, PrimitivePS, GIdentityPrimitiveUniformBuffer);
+
+		FMaterialShader::SetParameters(BatchedParameters, MaterialProxy, *MaterialResource, View);
+
+		const FMatrix DecalToWorldMatrix = VisibleDecal.ComponentTrans.ToMatrixWithScale();
+		const FDFVector3 AbsoluteOrigin(DecalToWorldMatrix.GetOrigin());
+		const FVector3f PositionHigh = AbsoluteOrigin.High;
+
+		SetShaderValue(BatchedParameters, DecalPositionHigh, PositionHigh);
+		SetShaderValue(BatchedParameters, DecalToWorld, FDFMatrix::MakeToRelativeWorldMatrix(PositionHigh, DecalToWorldMatrix).M);
+		SetShaderValue(BatchedParameters, DecalToWorldInvScale, static_cast<FVector3f>(DecalToWorldMatrix.GetScaleVector().Reciprocal()));
+		SetShaderValue(BatchedParameters, DecalOrientation, (FVector3f)VisibleDecal.ComponentTrans.GetUnitAxis(EAxis::X));
+		SetShaderValue(BatchedParameters, DecalParams, FVector2f(1.0f, LifetimeAlpha));
+		SetShaderValue(BatchedParameters, DecalColorParam, VisibleDecal.DecalColor);
+		SetShaderValue(BatchedParameters, BakeTileRect, TileRect);
+		SetShaderValue(BatchedParameters, BakeDecalToTranslatedWorld, FMatrix44f(DecalToWorldMatrix * FTranslationMatrix(View.ViewMatrices.GetPreViewTranslation())));
+	}
+
+private:
+	LAYOUT_FIELD(FShaderParameter, DecalPositionHigh);
+	LAYOUT_FIELD(FShaderParameter, DecalToWorld);
+	LAYOUT_FIELD(FShaderParameter, DecalToWorldInvScale);
+	LAYOUT_FIELD(FShaderParameter, DecalOrientation);
+	LAYOUT_FIELD(FShaderParameter, DecalParams);
+	LAYOUT_FIELD(FShaderParameter, DecalColorParam);
+	LAYOUT_FIELD(FShaderParameter, BakeTileRect);
+	LAYOUT_FIELD(FShaderParameter, BakeDecalToTranslatedWorld);
+};
+
+IMPLEMENT_MATERIAL_SHADER_TYPE(, FMobileClusteredDecalBakePS, TEXT("/Engine/Private/MobileClusteredDecalBake.usf"), TEXT("MainPS"), SF_Pixel);
+
+class FMobileClusteredDecalAtlas : public ISceneExtension
+{
+	DECLARE_SCENE_EXTENSION(, FMobileClusteredDecalAtlas);
+
+public:
+	using ISceneExtension::ISceneExtension;
+
+	struct FSlot
+	{
+		uintptr_t Component = 0;
+		uint32 Hash = 0;
+		uint32 LastUsedFrame = 0;
+	};
+
+	TRefCountPtr<IPooledRenderTarget> Atlas[3];
+	int32 AtlasSize = 0;
+	int32 TileSize = 0;
+	TArray<FSlot> Slots;
+	TMap<uintptr_t, int32> SlotByComponent;
+
+	int32 TilesPerSide() const { return AtlasSize / TileSize; }
+
+	FIntPoint GetTileMin(int32 Slot) const { return FIntPoint(Slot % TilesPerSide(), Slot / TilesPerSide()) * TileSize; }
+
+	/** A free slot, or the one least recently used before this frame. INDEX_NONE when every slot is in use this frame. */
+	int32 Allocate(uintptr_t Component, uint32 FrameNumber)
+	{
+		int32 Best = INDEX_NONE;
+		for (int32 Index = 0; Index < Slots.Num(); Index++)
+		{
+			const FSlot& Slot = Slots[Index];
+			if (Slot.Component == 0)
+			{
+				Best = Index;
+				break;
+			}
+			if (Slot.LastUsedFrame != FrameNumber && (Best == INDEX_NONE || Slot.LastUsedFrame < Slots[Best].LastUsedFrame))
+			{
+				Best = Index;
+			}
+		}
+
+		if (Best != INDEX_NONE)
+		{
+			SlotByComponent.Remove(Slots[Best].Component);
+			Slots[Best] = FSlot{ Component, 0, FrameNumber };
+			SlotByComponent.Add(Component, Best);
+		}
+		return Best;
+	}
+};
+
+IMPLEMENT_SCENE_EXTENSION(FMobileClusteredDecalAtlas);
+
+namespace MobileClusteredDecals
+{
+	/** Five float4 per decal: translated world to decal space (three rows), atlas scale and bias, then (fade, write mask, 0, 0). */
+	constexpr int32 Float4PerDecal = 5;
+
+	struct FBake
+	{
+		const FVisibleDecal* Decal;
+		const FMaterialRenderProxy* MaterialProxy;
+		const FMaterial* Material;
+		TShaderRef<FMobileClusteredDecalBakePS> PixelShader;
+		FIntPoint TileMin;
+		float LifetimeAlpha;
+	};
+
+	static float GetLifetimeAlpha(const FViewInfo& View, const FVisibleDecal& Decal)
+	{
+		// Matches the scene colour decal pass. Captures without a world time stay fully opaque.
+		const double Time = View.Family->Time.GetWorldTimeSeconds();
+		if (!Time)
+		{
+			return 1.0f;
+		}
+		return FMath::Clamp(FMath::Min((float)Time * -Decal.InvFadeDuration + Decal.FadeStartDelayNormalized, (float)Time * Decal.InvFadeInDuration + Decal.FadeInStartDelayNormalized), 0.0f, 1.0f);
+	}
+
+	static uint32 GetBakeHash(const FVisibleDecal& Decal, float LifetimeAlpha)
+	{
+		const FMatrix44f Matrix(Decal.ComponentTrans.ToMatrixWithScale());
+		uint32 Hash = FCrc::MemCrc32(&Matrix, sizeof(Matrix));
+		Hash = HashCombine(Hash, PointerHash(Decal.MaterialProxy));
+		Hash = HashCombine(Hash, GetTypeHash(Decal.DecalColor));
+		Hash = HashCombine(Hash, GetTypeHash(FMath::RoundToInt32(LifetimeAlpha * 255.0f)));
+		// Zero means not baked
+		return Hash ? Hash : 1;
+	}
+
+	static void EnsureAtlas(FRDGBuilder& GraphBuilder, FMobileClusteredDecalAtlas& Atlas)
+	{
+		const int32 TileSize = FMath::Clamp((int32)FMath::RoundUpToPowerOfTwo((uint32)FMath::Max(CVarMobileClusteredDecalsTileSize.GetValueOnRenderThread(), 1)), 16, 2048);
+		const int32 AtlasSize = FMath::Clamp((int32)FMath::RoundUpToPowerOfTwo((uint32)FMath::Max(CVarMobileClusteredDecalsAtlasSize.GetValueOnRenderThread(), 1)), TileSize, 8192);
+		if (Atlas.Atlas[0] && Atlas.AtlasSize == AtlasSize && Atlas.TileSize == TileSize)
+		{
+			return;
+		}
+
+		Atlas.AtlasSize = AtlasSize;
+		Atlas.TileSize = TileSize;
+		Atlas.Slots.Reset();
+		Atlas.Slots.SetNum(FMath::Square(Atlas.TilesPerSide()));
+		Atlas.SlotByComponent.Reset();
+
+		static const TCHAR* Names[] = { TEXT("MobileClusteredDecalAtlasA"), TEXT("MobileClusteredDecalAtlasB"), TEXT("MobileClusteredDecalAtlasC") };
+		for (int32 Index = 0; Index < 3; Index++)
+		{
+			const FRDGTextureDesc Desc = FRDGTextureDesc::Create2D(FIntPoint(AtlasSize), PF_B8G8R8A8, FClearValueBinding::Transparent, TexCreate_ShaderResource | TexCreate_RenderTargetable);
+			FRDGTextureRef Texture = GraphBuilder.CreateTexture(Desc, Names[Index]);
+			AddClearRenderTargetPass(GraphBuilder, Texture);
+			Atlas.Atlas[Index] = GraphBuilder.ConvertToExternalTexture(Texture);
+		}
+	}
+
+	/** The decal box's footprint on screen in view-relative pixels, or the whole view when part of it is behind the camera. */
+	static FIntRect GetScreenRect(const FViewInfo& View, const FVisibleDecal& Decal)
+	{
+		const FIntPoint ViewSize = View.ViewRect.Size();
+		const FIntRect WholeView(FIntPoint::ZeroValue, ViewSize);
+		const FMatrix DecalToClip = Decal.ComponentTrans.ToMatrixWithScale() * View.ViewMatrices.GetWorldToClip();
+
+		FVector2D Min(UE_BIG_NUMBER), Max(-UE_BIG_NUMBER);
+		for (int32 Corner = 0; Corner < 8; Corner++)
+		{
+			const FVector4 Clip = DecalToClip.TransformFVector4(FVector4((Corner & 1) ? 1.0 : -1.0, (Corner & 2) ? 1.0 : -1.0, (Corner & 4) ? 1.0 : -1.0, 1.0));
+			if (Clip.W <= UE_KINDA_SMALL_NUMBER)
+			{
+				return WholeView;
+			}
+			const FVector2D Pixel((Clip.X / Clip.W * 0.5 + 0.5) * ViewSize.X, (0.5 - Clip.Y / Clip.W * 0.5) * ViewSize.Y);
+			Min = FVector2D::Min(Min, Pixel);
+			Max = FVector2D::Max(Max, Pixel);
+		}
+
+		FIntRect Rect(FIntPoint(FMath::FloorToInt32(Min.X), FMath::FloorToInt32(Min.Y)), FIntPoint(FMath::CeilToInt32(Max.X), FMath::CeilToInt32(Max.Y)));
+		Rect.Clip(WholeView);
+		return Rect;
+	}
+
+	static void AddBakePass(FRDGBuilder& GraphBuilder, FViewInfo& View, const FMobileClusteredDecalAtlas& Atlas, const FSceneTextures& SceneTextures, TArray<FBake, SceneRenderingAllocator>&& Bakes)
+	{
+		FDeferredDecalPassTextures DecalPassTextures = GetDeferredDecalPassTextures(GraphBuilder, View, SceneTextures, nullptr, EDecalRenderStage::BeforeBasePass);
+
+		FDeferredDecalPassParameters* PassParameters = GraphBuilder.AllocParameters<FDeferredDecalPassParameters>();
+		PassParameters->View = View.GetShaderParameters();
+		PassParameters->Scene = View.GetSceneUniforms().GetBuffer(GraphBuilder);
+		PassParameters->DeferredDecal = CreateDeferredDecalUniformBuffer(View);
+		PassParameters->DecalPass = DecalPassTextures.DecalPassUniformBuffer;
+		for (int32 Index = 0; Index < 3; Index++)
+		{
+			PassParameters->RenderTargets[Index] = FRenderTargetBinding(GraphBuilder.RegisterExternalTexture(Atlas.Atlas[Index]), ERenderTargetLoadAction::ELoad);
+		}
+
+		const int32 TileSize = Atlas.TileSize;
+		const FViewInfo* ViewPtr = &View;
+		GraphBuilder.AddPass(
+			RDG_EVENT_NAME("BakeDecals %d", Bakes.Num()),
+			PassParameters,
+			ERDGPassFlags::Raster,
+			[ViewPtr, TileSize, Bakes = MoveTemp(Bakes)](FRHICommandList& RHICmdList)
+			{
+				for (const FBake& Bake : Bakes)
+				{
+					RHICmdList.SetViewport(Bake.TileMin.X, Bake.TileMin.Y, 0.0f, Bake.TileMin.X + TileSize, Bake.TileMin.Y + TileSize, 1.0f);
+
+					FGraphicsPipelineStateInitializer GraphicsPSOInit;
+					RHICmdList.ApplyCachedRenderTargets(GraphicsPSOInit);
+					FPixelShaderUtils::InitFullscreenPipelineState(RHICmdList, ViewPtr->ShaderMap, Bake.PixelShader, GraphicsPSOInit);
+					SetGraphicsPipelineState(RHICmdList, GraphicsPSOInit, 0);
+
+					const FVector4f TileRect((float)Bake.TileMin.X, (float)Bake.TileMin.Y, 1.0f / TileSize, 1.0f / TileSize);
+					SetShaderParametersLegacyPS(RHICmdList, Bake.PixelShader, *ViewPtr, *Bake.Decal, Bake.MaterialProxy, Bake.Material, TileRect, Bake.LifetimeAlpha);
+					FPixelShaderUtils::DrawFullscreenTriangle(RHICmdList);
+				}
+			});
+	}
+}
+
+void BuildMobileClusteredDecals(FRDGBuilder& GraphBuilder, FScene* Scene, FViewInfo& View, TConstArrayView<const FVisibleDecal*> RelevantDecals, const FSceneTextures& SceneTextures)
+{
+	TRACE_CPUPROFILER_EVENT_SCOPE(MobileClusteredDecals::BuildMobileClusteredDecals);
+
+	View.MobileClusteredDecals = nullptr;
+	const EShaderPlatform Platform = View.GetShaderPlatform();
+	FMobileClusteredDecalAtlas* Atlas = Scene ? Scene->GetExtensionPtr<FMobileClusteredDecalAtlas>() : nullptr;
+	if (!Atlas || !IsMobileClusteredDecalsEnabled(Platform) || RelevantDecals.IsEmpty() || !View.Family->EngineShowFlags.Decals)
+	{
+		return;
+	}
+
+	RDG_EVENT_SCOPE_STAT(GraphBuilder, MobileClusteredDecals, "MobileClusteredDecals");
+
+	MobileClusteredDecals::EnsureAtlas(GraphBuilder, *Atlas);
+
+	const uint32 FrameNumber = View.Family->FrameNumber;
+	const bool bRebakeAll = CVarMobileClusteredDecalsRebakeEveryFrame.GetValueOnRenderThread() != 0;
+	const ERHIFeatureLevel::Type FeatureLevel = View.GetFeatureLevel();
+
+	TArray<MobileClusteredDecals::FBake, SceneRenderingAllocator> Bakes;
+	TArray<TPair<const FVisibleDecal*, int32>, SceneRenderingAllocator> Placed;
+
+	for (const FVisibleDecal* Decal : RelevantDecals)
+	{
+		if (!CanMobileDecalBeClustered(Decal->BlendDesc))
+		{
+			continue;
+		}
+
+		// A material still compiling falls back to the scene colour path until its bake shader exists
+		const FMaterialRenderProxy* MaterialProxy = Decal->MaterialProxy;
+		const FMaterial* Material = MaterialProxy ? MaterialProxy->GetMaterialNoFallback(FeatureLevel) : nullptr;
+		FMaterialShaders Shaders;
+		FMaterialShaderTypes ShaderTypes;
+		ShaderTypes.AddShaderType<FMobileClusteredDecalBakePS>();
+		TShaderRef<FMobileClusteredDecalBakePS> PixelShader;
+		if (!Material || !Material->TryGetShaders(ShaderTypes, nullptr, Shaders) || !Shaders.TryGetPixelShader(PixelShader))
+		{
+			continue;
+		}
+
+		int32 SlotIndex = Atlas->SlotByComponent.FindRef(Decal->Component, INDEX_NONE);
+		if (SlotIndex == INDEX_NONE)
+		{
+			SlotIndex = Atlas->Allocate(Decal->Component, FrameNumber);
+			if (SlotIndex == INDEX_NONE)
+			{
+				continue;
+			}
+		}
+
+		FMobileClusteredDecalAtlas::FSlot& Slot = Atlas->Slots[SlotIndex];
+		Slot.LastUsedFrame = FrameNumber;
+
+		const float LifetimeAlpha = MobileClusteredDecals::GetLifetimeAlpha(View, *Decal);
+		const uint32 Hash = MobileClusteredDecals::GetBakeHash(*Decal, LifetimeAlpha);
+		if (bRebakeAll || Slot.Hash != Hash)
+		{
+			Slot.Hash = Hash;
+			Bakes.Add({ Decal, MaterialProxy, Material, PixelShader, Atlas->GetTileMin(SlotIndex), LifetimeAlpha });
+		}
+		Placed.Emplace(Decal, SlotIndex);
+	}
+
+	if (Placed.IsEmpty())
+	{
+		return;
+	}
+
+	if (!Bakes.IsEmpty())
+	{
+		MobileClusteredDecals::AddBakePass(GraphBuilder, View, *Atlas, SceneTextures, MoveTemp(Bakes));
+	}
+
+	const uint32 TileShift = FMath::Clamp(CVarMobileClusteredDecalsScreenTileShift.GetValueOnRenderThread(), 3, 8);
+	const uint32 MaxPerTile = FMath::Clamp(CVarMobileClusteredDecalsMaxPerTile.GetValueOnRenderThread(), 1, 32);
+	const uint32 TileStride = MaxPerTile + 1;
+	const FIntPoint TileCount(
+		FMath::DivideAndRoundUp(View.ViewRect.Width(), 1 << TileShift),
+		FMath::DivideAndRoundUp(View.ViewRect.Height(), 1 << TileShift));
+
+	TArray<FVector4f, SceneRenderingAllocator> DecalData;
+	TArray<uint32, SceneRenderingAllocator> TileData;
+	DecalData.Reserve(Placed.Num() * MobileClusteredDecals::Float4PerDecal);
+	TileData.SetNumZeroed(TileCount.X * TileCount.Y * TileStride);
+
+	FMobileClusteredDecalViewData* ViewData = GraphBuilder.AllocObject<FMobileClusteredDecalViewData>();
+	const FMatrix TranslatedWorldToWorld = FTranslationMatrix(-View.ViewMatrices.GetPreViewTranslation());
+	const float AtlasTexel = 1.0f / Atlas->AtlasSize;
+
+	for (const TPair<const FVisibleDecal*, int32>& Entry : Placed)
+	{
+		const FVisibleDecal& Decal = *Entry.Key;
+		const FIntRect ScreenRect = MobileClusteredDecals::GetScreenRect(View, Decal);
+		if (ScreenRect.Area() <= 0)
+		{
+			continue;
+		}
+
+		const uint32 DecalIndex = ViewData->NumDecals++;
+		ViewData->Decals.Add(Entry.Key);
+
+		const FMatrix TranslatedWorldToDecal = TranslatedWorldToWorld * Decal.ComponentTrans.ToInverseMatrixWithScale();
+		for (int32 Column = 0; Column < 3; Column++)
+		{
+			DecalData.Add(FVector4f(
+				(float)TranslatedWorldToDecal.M[0][Column], (float)TranslatedWorldToDecal.M[1][Column],
+				(float)TranslatedWorldToDecal.M[2][Column], (float)TranslatedWorldToDecal.M[3][Column]));
+		}
+
+		// Half a texel in from the tile's edges, so bilinear filtering never reads a neighbouring decal
+		const FIntPoint TileMin = Atlas->GetTileMin(Entry.Value);
+		DecalData.Add(FVector4f(
+			(Atlas->TileSize - 1) * AtlasTexel, (Atlas->TileSize - 1) * AtlasTexel,
+			(TileMin.X + 0.5f) * AtlasTexel, (TileMin.Y + 0.5f) * AtlasTexel));
+
+		const uint32 WriteMask = (Decal.BlendDesc.bWriteBaseColor ? 1u : 0u) | (Decal.BlendDesc.bWriteNormal ? 2u : 0u) | (Decal.BlendDesc.bWriteRoughnessSpecularMetallic ? 4u : 0u);
+		DecalData.Add(FVector4f(Decal.FadeAlpha, (float)WriteMask, 0.0f, 0.0f));
+
+		const FIntPoint FirstTile(ScreenRect.Min.X >> TileShift, ScreenRect.Min.Y >> TileShift);
+		const FIntPoint LastTile(FMath::Min((ScreenRect.Max.X - 1) >> TileShift, TileCount.X - 1), FMath::Min((ScreenRect.Max.Y - 1) >> TileShift, TileCount.Y - 1));
+		for (int32 Y = FirstTile.Y; Y <= LastTile.Y; Y++)
+		{
+			for (int32 X = FirstTile.X; X <= LastTile.X; X++)
+			{
+				uint32* Tile = &TileData[(Y * TileCount.X + X) * TileStride];
+				if (Tile[0] < MaxPerTile)
+				{
+					Tile[1 + Tile[0]++] = DecalIndex;
+				}
+			}
+		}
+	}
+
+	if (ViewData->NumDecals == 0)
+	{
+		return;
+	}
+
+	ViewData->DecalData = GraphBuilder.CreateSRV(CreateStructuredBuffer(GraphBuilder, TEXT("MobileClusteredDecals.Decals"), TConstArrayView<FVector4f>(DecalData)));
+	ViewData->TileData = GraphBuilder.CreateSRV(CreateStructuredBuffer(GraphBuilder, TEXT("MobileClusteredDecals.Tiles"), TConstArrayView<uint32>(TileData)));
+	ViewData->AtlasA = GraphBuilder.RegisterExternalTexture(Atlas->Atlas[0]);
+	ViewData->AtlasB = GraphBuilder.RegisterExternalTexture(Atlas->Atlas[1]);
+	ViewData->AtlasC = GraphBuilder.RegisterExternalTexture(Atlas->Atlas[2]);
+	ViewData->TileCount = TileCount;
+	ViewData->TileSizeShift = TileShift;
+	ViewData->TileStride = TileStride;
+	View.MobileClusteredDecals = ViewData;
+}
+
+void SetMobileClusteredDecalParameters(FRDGBuilder& GraphBuilder, const FMobileClusteredDecalViewData* ViewData, FMobileBasePassUniformParameters& Parameters)
+{
+	const FRDGSystemTextures& SystemTextures = FRDGSystemTextures::Get(GraphBuilder);
+	Parameters.ClusteredDecalAtlasSampler = TStaticSamplerState<SF_Bilinear, AM_Clamp, AM_Clamp, AM_Clamp>::GetRHI();
+	if (ViewData)
+	{
+		Parameters.ClusteredDecalData = ViewData->DecalData;
+		Parameters.ClusteredDecalTiles = ViewData->TileData;
+		Parameters.ClusteredDecalAtlasA = ViewData->AtlasA;
+		Parameters.ClusteredDecalAtlasB = ViewData->AtlasB;
+		Parameters.ClusteredDecalAtlasC = ViewData->AtlasC;
+		Parameters.ClusteredDecalTileCount = ViewData->TileCount;
+		Parameters.ClusteredDecalTileShift = ViewData->TileSizeShift;
+		Parameters.ClusteredDecalTileStride = ViewData->TileStride;
+		Parameters.NumClusteredDecals = ViewData->NumDecals;
+	}
+	else
+	{
+		Parameters.ClusteredDecalData = GraphBuilder.CreateSRV(GSystemTextures.GetDefaultStructuredBuffer(GraphBuilder, sizeof(FVector4f)));
+		Parameters.ClusteredDecalTiles = GraphBuilder.CreateSRV(GSystemTextures.GetDefaultStructuredBuffer(GraphBuilder, sizeof(uint32)));
+		Parameters.ClusteredDecalAtlasA = SystemTextures.Black;
+		Parameters.ClusteredDecalAtlasB = SystemTextures.Black;
+		Parameters.ClusteredDecalAtlasC = SystemTextures.Black;
+		Parameters.ClusteredDecalTileCount = FIntPoint::ZeroValue;
+		Parameters.ClusteredDecalTileShift = 0;
+		Parameters.ClusteredDecalTileStride = 0;
+		Parameters.NumClusteredDecals = 0;
+	}
+}
