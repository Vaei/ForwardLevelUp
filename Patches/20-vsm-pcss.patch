 #pragma once
 
 #include "VirtualShadowMaps/VirtualShadowMapProjectionCommon.ush"
+#include "Random.ush"
 
 #ifndef MOBILE_VSM_FILTER_TAPS
 #define MOBILE_VSM_FILTER_TAPS 5
 #endif
 
+#define MOBILE_VSM_PCSS_BLOCKER_TAPS 8
+#define MOBILE_VSM_PCSS_FILTER_TAPS 16
+
+FVirtualShadowMapSampleResult SampleMobileVirtualShadowMap(bool bDirectional, int VirtualShadowMapId, float3 TranslatedWorldPosition, float RayStartDistance, float3 WorldNormal, float SceneDepth)
+{
+	if (bDirectional)
+	{
+		return SampleVirtualShadowMapDirectional(VirtualShadowMapId, TranslatedWorldPosition, RayStartDistance, WorldNormal, true, SceneDepth);
+	}
+	return SampleVirtualShadowMapLocal(VirtualShadowMapId, TranslatedWorldPosition, RayStartDistance, WorldNormal, true, SceneDepth);
+}
+
+/** Point on a unit disk, spread evenly over Count points and rotated. */
+float2 MobileVogelDisk(uint Index, uint Count, float Rotation)
+{
+	const float Radius = sqrt((Index + 0.5f) / Count);
+	const float Angle = Index * 2.39996323f + Rotation;
+	return Radius * float2(cos(Angle), sin(Angle));
+}
+
+/** A rotation fixed to the screen pixel, so the PCSS taps dither between pixels without changing between frames. */
+float GetMobileVirtualShadowMapRotation(float3 TranslatedWorldPosition)
+{
+	const float4 Clip = mul(float4(TranslatedWorldPosition, 1.0f), View.TranslatedWorldToClip);
+	const float2 Pixel = (Clip.xy / Clip.w * float2(0.5f, -0.5f) + 0.5f) * View.ViewSizeAndInvSize.xy;
+	return 2.0f * PI * InterleavedGradientNoise(Pixel, 0);
+}
+
+/**
+ * Percentage-closer soft shadows: a blocker search around the receiver finds the mean occluder distance, which sets the penumbra
+ * width from the light's size, then the PCF taps spread over it. Contact stays hard and the penumbra widens with distance.
+ * LightSourceRadius is the sine of the half angle for a directional light, otherwise a world radius at LightDistance.
+ */
+half MobileVirtualShadowMapPCSS(bool bDirectional, int VirtualShadowMapId, float3 BiasedPosition, float RayStartDistance, float3 WorldNormal, float SceneDepth,
+	float3 TangentX, float3 TangentY, float MinRadius, float MaxRadius, float LightSourceRadius, float LightDistance)
+{
+	const float Rotation = GetMobileVirtualShadowMapRotation(BiasedPosition);
+	const float TanHalfAngle = LightSourceRadius * rsqrt(max(1.0f - LightSourceRadius * LightSourceRadius, 0.0001f));
+	const float SearchRadius = min(bDirectional ? 2.0f * TanHalfAngle * MobileBasePass.VirtualShadowMapPCSSSearchDistance : LightSourceRadius, MaxRadius);
+
+	float OccluderDistanceSum = 0.0f;
+	float NumOccluders = 0.0f;
+	LOOP
+	for (uint SearchIndex = 0; SearchIndex < MOBILE_VSM_PCSS_BLOCKER_TAPS; ++SearchIndex)
+	{
+		const float2 Disk = MobileVogelDisk(SearchIndex, MOBILE_VSM_PCSS_BLOCKER_TAPS, Rotation) * SearchRadius;
+		const FVirtualShadowMapSampleResult Result = SampleMobileVirtualShadowMap(bDirectional, VirtualShadowMapId, BiasedPosition + TangentX * Disk.x + TangentY * Disk.y, RayStartDistance, WorldNormal, SceneDepth);
+		if (Result.ShadowFactor < 0.5f && Result.OccluderDistance >= 0.0f)
+		{
+			OccluderDistanceSum += Result.OccluderDistance;
+			NumOccluders += 1.0f;
+		}
+	}
+	if (NumOccluders == 0.0f)
+	{
+		return 1.0f;
+	}
+
+	const float OccluderDistance = OccluderDistanceSum / NumOccluders;
+	// Similar triangles between the light, the occluder and the receiver
+	const float Penumbra = bDirectional
+		? 2.0f * TanHalfAngle * OccluderDistance
+		: 2.0f * LightSourceRadius * OccluderDistance / max(LightDistance - OccluderDistance, 1.0f);
+	const float Radius = clamp(0.5f * Penumbra, MinRadius, MaxRadius);
+
+	half Lit = 0.0f;
+	LOOP
+	for (uint TapIndex = 0; TapIndex < MOBILE_VSM_PCSS_FILTER_TAPS; ++TapIndex)
+	{
+		const float2 Disk = MobileVogelDisk(TapIndex, MOBILE_VSM_PCSS_FILTER_TAPS, Rotation) * Radius;
+		Lit += half(SampleMobileVirtualShadowMap(bDirectional, VirtualShadowMapId, BiasedPosition + TangentX * Disk.x + TangentY * Disk.y, RayStartDistance, WorldNormal, SceneDepth).ShadowFactor);
+	}
+	return Lit / half(MOBILE_VSM_PCSS_FILTER_TAPS);
+}
+
