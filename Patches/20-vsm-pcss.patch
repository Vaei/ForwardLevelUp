@@ -26,6 +102,13 @@ half MobileVirtualShadowMapFilter(bool bDirectional, int VirtualShadowMapId, flo
 	const float3 BiasedPosition = TranslatedWorldPosition + WorldNormal * (PixelFootprint * MobileBasePass.VirtualShadowMapNormalBias);
 	const float RayStartDistance = PixelFootprint * MobileBasePass.VirtualShadowMapNormalBias;
 
+	BRANCH
+	if (MobileBasePass.VirtualShadowMapFilterMode == 1 && LightSourceRadius > 0.0f)
+	{
+		return MobileVirtualShadowMapPCSS(bDirectional, VirtualShadowMapId, BiasedPosition, RayStartDistance, WorldNormal, SceneDepth,
+			TangentX, TangentY, Radius, PixelFootprint * MobileBasePass.VirtualShadowMapPCSSMaxPenumbra, LightSourceRadius, LightDistance);
+	}
+
 #if MOBILE_VSM_FILTER_TAPS >= 9
 	const float2 Taps[9] = { float2(0, 0), float2(1, 0), float2(-1, 0), float2(0, 1), float2(0, -1), float2(0.707f, 0.707f), float2(-0.707f, 0.707f), float2(0.707f, -0.707f), float2(-0.707f, -0.707f) };
 	const int NumTaps = 9;
@@ -42,16 +125,7 @@ half MobileVirtualShadowMapFilter(bool bDirectional, int VirtualShadowMapId, flo
 	for (int TapIndex = 0; TapIndex < NumTaps; ++TapIndex)
 	{
 		const float3 TapPosition = BiasedPosition + (TangentX * Taps[TapIndex].x + TangentY * Taps[TapIndex].y) * Radius;
-		FVirtualShadowMapSampleResult Result;
-		if (bDirectional)
-		{
-			Result = SampleVirtualShadowMapDirectional(VirtualShadowMapId, TapPosition, RayStartDistance, WorldNormal, true, SceneDepth);
-		}
-		else
-		{
-			Result = SampleVirtualShadowMapLocal(VirtualShadowMapId, TapPosition, RayStartDistance, WorldNormal, true, SceneDepth);
-		}
-		Lit += half(Result.ShadowFactor);
+		Lit += half(SampleMobileVirtualShadowMap(bDirectional, VirtualShadowMapId, TapPosition, RayStartDistance, WorldNormal, SceneDepth).ShadowFactor);
 	}
 	return Lit / half(NumTaps);
 }
