+/** Desktop, plus the mobile renderer on PC where MSAA targets can be loaded per sample. */
+inline bool SupportsWideCustomResolve(const FStaticShaderPlatform Platform)
+{
+	return IsFeatureLevelSupported(Platform, ERHIFeatureLevel::SM5) || (IsMobilePlatform(Platform) && (IsPCPlatform(Platform) || IsSimulatedPlatform(Platform)));
+}
