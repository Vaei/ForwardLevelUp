diff --git a/Engine/Shaders/Private/WideCustomResolveShaders.usf b/Engine/Shaders/Private/WideCustomResolveShaders.usf
index 2e70e2847491..80b2740cd9cb 100644
--- a/Engine/Shaders/Private/WideCustomResolveShaders.usf
+++ b/Engine/Shaders/Private/WideCustomResolveShaders.usf
@@ -76,10 +76,24 @@ float3 resolve_bspline(uint2 pos)
 #  error "Unknown filter width"
 # endif
 
+#ifndef WIDE_RESOLVE_KEEP_ALPHA
+#define WIDE_RESOLVE_KEEP_ALPHA 0
+#endif
+
 float4 WideCustomResolvePS(float4 Pos : SV_POSITION) : SV_Target0
 {
 	uint2 P = uint2(ResolveOrigin + Pos.xy);
-	return float4(resolve_bspline(P), 0);
+	float Alpha = 0;
+#if WIDE_RESOLVE_KEEP_ALPHA
+	// The mobile renderer reads scene color alpha downstream, so box-resolve it from this pixel's own samples
+	UNROLL
+	for (int SampleIndex = 0; SampleIndex < MSAA_SAMPLE_COUNT; ++SampleIndex)
+	{
+		Alpha += Tex.Load(P, SampleIndex).a;
+	}
+	Alpha /= MSAA_SAMPLE_COUNT;
+#endif
+	return float4(resolve_bspline(P), Alpha);
 }
 
 # endif
