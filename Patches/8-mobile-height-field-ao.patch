@@ -0,0 +1,94 @@
+// Copyright (c) 2026 Jared Taylor.
+
+#include "Common.ush"
+
+Texture2D SceneDepthTexture;
+Texture2D HeightTexture;
+SamplerState HeightSampler;
+float4 HeightUVScaleBias;
+float2 HeightWorldSize;
+float HeightTop;
+float MaxDistance;
+float MinDistance;
+float NormalBias;
+float Intensity;
+uint NumDirections;
+uint NumSteps;
+
+float2 GetHeightUV(float2 TranslatedWorldXY)
+{
+	return TranslatedWorldXY.yx * HeightUVScaleBias.xy + HeightUVScaleBias.zw;
+}
+
+float SampleHeight(float2 TranslatedWorldXY)
+{
+	return HeightTop - HeightTexture.SampleLevel(HeightSampler, GetHeightUV(TranslatedWorldXY), 0).a;
+}
+
+float3 PixelToTranslatedWorld(int2 Pixel)
+{
+	const float DeviceZ = SceneDepthTexture.Load(int3(Pixel, 0)).r;
+	const float4 Position = mul(float4(Pixel + 0.5, DeviceZ, 1), View.SVPositionToTranslatedWorld);
+	return Position.xyz / Position.w;
+}
+
+/** Each axis uses the neighbour with the smaller step, so silhouettes do not bend the normal. */
+float3 ReconstructNormal(int2 Pixel, float3 Center)
+{
+	const float3 Left = PixelToTranslatedWorld(Pixel - int2(1, 0));
+	const float3 Right = PixelToTranslatedWorld(Pixel + int2(1, 0));
+	const float3 Up = PixelToTranslatedWorld(Pixel - int2(0, 1));
+	const float3 Down = PixelToTranslatedWorld(Pixel + int2(0, 1));
+
+	const float3 TangentX = length2(Right - Center) < length2(Center - Left) ? Right - Center : Center - Left;
+	const float3 TangentY = length2(Down - Center) < length2(Center - Up) ? Down - Center : Center - Up;
+	const float3 Normal = normalize(cross(TangentY, TangentX));
+	return dot(Normal, Center - View.TranslatedWorldCameraOrigin) > 0 ? -Normal : Normal;
+}
+
+void MainPS(float4 SvPosition : SV_POSITION, out float4 OutColor : SV_Target0)
+{
+	const int2 Pixel = int2(SvPosition.xy);
+	if (SceneDepthTexture.Load(int3(Pixel, 0)).r == FarDepthValue)
+	{
+		OutColor = 1;
+		return;
+	}
+
+	const float3 Position = PixelToTranslatedWorld(Pixel);
+	const float3 Normal = ReconstructNormal(Pixel, Position);
+	const float3 Origin = Position + Normal * NormalBias;
+
+	const float2 UV = GetHeightUV(Origin.xy);
+	const float2 EdgeDistance = min(UV, 1 - UV) * HeightWorldSize;
+	const float EdgeFade = saturate(min(EdgeDistance.x, EdgeDistance.y) / MaxDistance);
+
+	float Visibility = 1;
+	if (EdgeFade > 0)
+	{
+		float VisibilitySum = 0;
+		float WeightSum = 0;
+		for (uint DirectionIndex = 0; DirectionIndex < NumDirections; DirectionIndex++)
+		{
+			float2 Direction;
+			sincos((DirectionIndex + 0.5) * (2 * PI / NumDirections), Direction.y, Direction.x);
+			// Directions into the surface cannot reach the sky, so they count for nothing
+			const float Weight = max(1 + dot(Direction, Normal.xy), 0);
+
+			float MaxSlope = 0;
+			for (uint StepIndex = 0; StepIndex < NumSteps; StepIndex++)
+			{
+				const float Fraction = (StepIndex + 1.0) / NumSteps;
+				const float Distance = lerp(MinDistance, MaxDistance, Fraction * Fraction);
+				MaxSlope = max(MaxSlope, (SampleHeight(Origin.xy + Direction * Distance) - Origin.z) / Distance);
+			}
+
+			// Cosine weighted sky above a horizon of this slope
+			VisibilitySum += Weight / (1 + MaxSlope * MaxSlope);
+			WeightSum += Weight;
+		}
+		Visibility = lerp(1, VisibilitySum / max(WeightSum, 1e-4), Intensity * EdgeFade);
+	}
+
+	OutColor = float4(Visibility, 0, 0, 0);
+}
