+// Copyright (c) 2026 Jared Taylor.
+
+#include "MobileHeightFieldAO.h"
+#include "MobileHeightFieldAORendering.h"
+#include "Engine/Texture.h"
+#include "PixelShaderUtils.h"
+#include "ProfilingDebugging/CpuProfilerTrace.h"
+#include "RenderGraphUtils.h"
+#include "RenderTargetPool.h"
+#include "SceneExtensions.h"
+#include "ScenePrivate.h"
+#include "SceneRendering.h"
+#include "TextureResource.h"
+
+static TAutoConsoleVariable<int32> CVarMobileHeightFieldAO(
+	TEXT("r.Mobile.HeightFieldAO"),
+	0,
+	TEXT("Sky occlusion from a top-down height texture set with SetMobileHeightFieldAO, multiplied into mobile ambient occlusion. Needs r.Mobile.AmbientOcclusion."),
+	ECVF_Scalability | ECVF_RenderThreadSafe);
+
+static TAutoConsoleVariable<float> CVarMobileHeightFieldAOMaxDistance(
+	TEXT("r.Mobile.HeightFieldAO.MaxDistance"),
+	3000.0f,
+	TEXT("World distance the horizon search reaches."),
+	ECVF_Scalability | ECVF_RenderThreadSafe);
+
+static TAutoConsoleVariable<float> CVarMobileHeightFieldAOMinDistance(
+	TEXT("r.Mobile.HeightFieldAO.MinDistance"),
+	0.0f,
+	TEXT("World distance the horizon search starts at. Raise it to the distance field AO range to leave near occlusion to DFAO."),
+	ECVF_Scalability | ECVF_RenderThreadSafe);
+
+static TAutoConsoleVariable<float> CVarMobileHeightFieldAOIntensity(
+	TEXT("r.Mobile.HeightFieldAO.Intensity"),
+	1.0f,
+	TEXT("0 disables the occlusion, 1 applies it fully."),
+	ECVF_Scalability | ECVF_RenderThreadSafe);
+
+static TAutoConsoleVariable<float> CVarMobileHeightFieldAONormalBias(
+	TEXT("r.Mobile.HeightFieldAO.NormalBias"),
+	150.0f,
+	TEXT("World distance the search origin moves along the surface normal, so walls and roof eaves do not occlude the wall."),
+	ECVF_Scalability | ECVF_RenderThreadSafe);
+
+static TAutoConsoleVariable<int32> CVarMobileHeightFieldAODirections(
+	TEXT("r.Mobile.HeightFieldAO.Directions"),
+	8,
+	TEXT("Horizon directions per pixel."),
+	ECVF_Scalability | ECVF_RenderThreadSafe);
+
+static TAutoConsoleVariable<int32> CVarMobileHeightFieldAOSteps(
+	TEXT("r.Mobile.HeightFieldAO.Steps"),
+	8,
+	TEXT("Height samples per direction."),
+	ECVF_Scalability | ECVF_RenderThreadSafe);
+
+DECLARE_GPU_STAT_NAMED(MobileHeightFieldAO, TEXT("Height Field AO"));
+
+class FMobileHeightFieldAOSceneExtension : public ISceneExtension
+{
+	DECLARE_SCENE_EXTENSION(, FMobileHeightFieldAOSceneExtension);
+
+public:
+	using ISceneExtension::ISceneExtension;
+
+	TRefCountPtr<IPooledRenderTarget> HeightTexture;
+	FBox WorldBounds = FBox(ForceInit);
+};
+
+IMPLEMENT_SCENE_EXTENSION(FMobileHeightFieldAOSceneExtension);
+
+void SetMobileHeightFieldAO(FSceneInterface* SceneInterface, UTexture* HeightTexture, const FBox& WorldBounds)
+{
+	TRACE_CPUPROFILER_EVENT_SCOPE(MobileHeightFieldAO::SetMobileHeightFieldAO);
+
+	FScene* Scene = SceneInterface ? SceneInterface->GetRenderScene() : nullptr;
+	if (!Scene)
+	{
+		return;
+	}
+
+	FTextureResource* Resource = HeightTexture ? HeightTexture->GetResource() : nullptr;
+	ENQUEUE_RENDER_COMMAND(SetMobileHeightFieldAO)([Scene, Resource, WorldBounds](FRHICommandListImmediate&)
+	{
+		if (FMobileHeightFieldAOSceneExtension* Extension = Scene->GetExtensionPtr<FMobileHeightFieldAOSceneExtension>())
+		{
+			FRHITexture* Texture = Resource ? Resource->GetTextureRHI() : nullptr;
+			Extension->HeightTexture = Texture ? CreateRenderTarget(Texture, TEXT("MobileHeightFieldAO")) : nullptr;
+			Extension->WorldBounds = WorldBounds;
+		}
+	});
+}
+
+class FMobileHeightFieldAOPS : public FGlobalShader
+{
+public:
+	DECLARE_GLOBAL_SHADER(FMobileHeightFieldAOPS);
+	SHADER_USE_PARAMETER_STRUCT(FMobileHeightFieldAOPS, FGlobalShader);
+
+	BEGIN_SHADER_PARAMETER_STRUCT(FParameters, )
+		SHADER_PARAMETER_STRUCT_REF(FViewUniformShaderParameters, View)
+		SHADER_PARAMETER_RDG_TEXTURE(Texture2D, SceneDepthTexture)
+		SHADER_PARAMETER_RDG_TEXTURE(Texture2D, HeightTexture)
+		SHADER_PARAMETER_SAMPLER(SamplerState, HeightSampler)
+		SHADER_PARAMETER(FVector4f, HeightUVScaleBias)
+		SHADER_PARAMETER(FVector2f, HeightWorldSize)
+		SHADER_PARAMETER(float, HeightTop)
+		SHADER_PARAMETER(float, MaxDistance)
+		SHADER_PARAMETER(float, MinDistance)
+		SHADER_PARAMETER(float, NormalBias)
+		SHADER_PARAMETER(float, Intensity)
+		SHADER_PARAMETER(uint32, NumDirections)
+		SHADER_PARAMETER(uint32, NumSteps)
+		RENDER_TARGET_BINDING_SLOTS()
+	END_SHADER_PARAMETER_STRUCT()
+
+	static bool ShouldCompilePermutation(const FGlobalShaderPermutationParameters& Parameters)
+	{
+		return IsMobilePlatform(Parameters.Platform);
+	}
+};
+
+IMPLEMENT_GLOBAL_SHADER(FMobileHeightFieldAOPS, "/Engine/Private/MobileHeightFieldAO.usf", "MainPS", SF_Pixel);
+
+void RenderMobileHeightFieldAO(FRDGBuilder& GraphBuilder, FScene* Scene, TArrayView<const FViewInfo> Views, FRDGTexture* SceneDepth, FRDGTexture* AmbientOcclusion)
+{
+	TRACE_CPUPROFILER_EVENT_SCOPE(MobileHeightFieldAO::RenderMobileHeightFieldAO);
+
+	const FMobileHeightFieldAOSceneExtension* Extension = Scene ? Scene->GetExtensionPtr<FMobileHeightFieldAOSceneExtension>() : nullptr;
+	const float Intensity = CVarMobileHeightFieldAOIntensity.GetValueOnRenderThread();
+	if (!CVarMobileHeightFieldAO.GetValueOnRenderThread() || !Extension || !Extension->HeightTexture || !Extension->WorldBounds.IsValid || Intensity <= 0.0f || !SceneDepth || !AmbientOcclusion)
+	{
+		return;
+	}
+
+	RDG_EVENT_SCOPE_STAT(GraphBuilder, MobileHeightFieldAO, "MobileHeightFieldAO");
+
+	FRDGTextureRef HeightTexture = GraphBuilder.RegisterExternalTexture(Extension->HeightTexture);
+	const FVector WorldSize = Extension->WorldBounds.GetSize();
+	const float MaxDistance = FMath::Max(CVarMobileHeightFieldAOMaxDistance.GetValueOnRenderThread(), 1.0f);
+
+	for (const FViewInfo& View : Views)
+	{
+		if (View.bIsSceneCapture || View.bIsReflectionCapture || View.bIsPlanarReflection || !View.Family->EngineShowFlags.AmbientOcclusion)
+		{
+			continue;
+		}
+
+		// The shader works in translated world space, so the bounds move by the view's translation
+		const FVector TranslatedMin = Extension->WorldBounds.Min + View.ViewMatrices.GetPreViewTranslation();
+		const FVector TranslatedMax = Extension->WorldBounds.Max + View.ViewMatrices.GetPreViewTranslation();
+
+		FMobileHeightFieldAOPS::FParameters* PassParameters = GraphBuilder.AllocParameters<FMobileHeightFieldAOPS::FParameters>();
+		PassParameters->View = View.ViewUniformBuffer;
+		PassParameters->SceneDepthTexture = SceneDepth;
+		PassParameters->HeightTexture = HeightTexture;
+		PassParameters->HeightSampler = TStaticSamplerState<SF_Bilinear, AM_Clamp, AM_Clamp, AM_Clamp>::GetRHI();
+		PassParameters->HeightUVScaleBias = FVector4f(
+			1.0f / WorldSize.Y, -1.0f / WorldSize.X,
+			-TranslatedMin.Y / WorldSize.Y, TranslatedMax.X / WorldSize.X);
+		PassParameters->HeightWorldSize = FVector2f(WorldSize.Y, WorldSize.X);
+		PassParameters->HeightTop = TranslatedMax.Z;
+		PassParameters->MaxDistance = MaxDistance;
+		PassParameters->MinDistance = FMath::Clamp(CVarMobileHeightFieldAOMinDistance.GetValueOnRenderThread(), 0.0f, MaxDistance);
+		PassParameters->NormalBias = CVarMobileHeightFieldAONormalBias.GetValueOnRenderThread();
+		PassParameters->Intensity = FMath::Min(Intensity, 1.0f);
+		PassParameters->NumDirections = FMath::Clamp(CVarMobileHeightFieldAODirections.GetValueOnRenderThread(), 1, 32);
+		PassParameters->NumSteps = FMath::Clamp(CVarMobileHeightFieldAOSteps.GetValueOnRenderThread(), 1, 32);
+		PassParameters->RenderTargets[0] = FRenderTargetBinding(AmbientOcclusion, ERenderTargetLoadAction::ELoad);
+
+		TShaderMapRef<FMobileHeightFieldAOPS> PixelShader(View.ShaderMap);
+		FPixelShaderUtils::AddFullscreenPass(
+			GraphBuilder,
+			View.ShaderMap,
+			RDG_EVENT_NAME("HeightFieldAO %dx%d", View.ViewRect.Width(), View.ViewRect.Height()),
+			PixelShader,
+			PassParameters,
+			View.ViewRect,
+			TStaticBlendState<CW_RED, BO_Add, BF_DestColor, BF_Zero>::GetRHI());
+	}
+}
