+// Copyright (c) 2026 Jared Taylor.
+
+#pragma once
+
+#include "CoreMinimal.h"
+
+class FSceneInterface;
+class UTexture;
+
+/**
+ * Sets the top-down height texture that r.Mobile.HeightFieldAO samples, or clears it when HeightTexture is null.
+ * A holds the distance below WorldBounds.Max.Z, as written by an orthographic SceneColorSceneDepth capture placed at the top
+ * of the bounds with rotation (Pitch -90, Yaw 0, Roll 0). U runs along world +Y and V along world -X.
+ * The texture must stay alive until it is cleared.
+ */
+RENDERER_API void SetMobileHeightFieldAO(FSceneInterface* Scene, UTexture* HeightTexture, const FBox& WorldBounds);
