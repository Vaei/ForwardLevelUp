+
+/**
+ * Sets a toroidal height texture instead: it covers WorldSize along each axis and is addressed by world position modulo WorldSize,
+ * so a window that follows the camera only has to capture the tiles it moves onto, into the texels that wrap around.
+ * A holds the distance below Top, with the same orientation as above. Only ValidBounds (world XY) is sampled; occlusion fades
+ * out towards its edges. Clear it with SetMobileHeightFieldAO(Scene, nullptr, FBox(ForceInit)).
+ */
+RENDERER_API void SetMobileHeightFieldAOWrapped(FSceneInterface* Scene, UTexture* HeightTexture, double WorldSize, double Top, const FBox2D& ValidBounds);
