+
+void SetMobileHeightFieldAOWrapped(FSceneInterface* SceneInterface, UTexture* HeightTexture, double WorldSize, double Top, const FBox2D& ValidBounds)
+{
+	TRACE_CPUPROFILER_EVENT_SCOPE(MobileHeightFieldAO::SetMobileHeightFieldAOWrapped);
+
+	FScene* Scene = SceneInterface ? SceneInterface->GetRenderScene() : nullptr;
+	if (!Scene)
+	{
+		return;
+	}
+
+	FTextureResource* Resource = HeightTexture ? HeightTexture->GetResource() : nullptr;
+	// Only Max.Z (the top) and the bounds' validity are read in wrapped mode
+	const FBox WorldBounds(FVector(ValidBounds.Min, Top - 1.0), FVector(ValidBounds.Max, Top));
+	ENQUEUE_RENDER_COMMAND(SetMobileHeightFieldAOWrapped)([Scene, Resource, WorldBounds, WorldSize, ValidBounds](FRHICommandListImmediate&)
+	{
+		if (FMobileHeightFieldAOSceneExtension* Extension = Scene->GetExtensionPtr<FMobileHeightFieldAOSceneExtension>())
+		{
+			FRHITexture* Texture = Resource ? Resource->GetTextureRHI() : nullptr;
+			Extension->HeightTexture = Texture && ValidBounds.bIsValid ? CreateRenderTarget(Texture, TEXT("MobileHeightFieldAO")) : nullptr;
+			Extension->WorldBounds = WorldBounds;
+			Extension->WrapSize = FMath::Max(WorldSize, 1.0);
+			Extension->ValidBounds = ValidBounds;
 		}
 	});
 }
