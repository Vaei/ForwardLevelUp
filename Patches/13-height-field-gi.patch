+/** Sun and sky light leaving a lambertian surface of this normal, in the base pass's diffuse lighting units. */
+float3 GetSurfaceLighting(float3 SurfaceNormal, float SunVisibility)
+{
+	return SunIlluminance * (saturate(dot(SurfaceNormal, SunDirection)) * SunVisibility / PI) + GetSkySHDiffuse(SurfaceNormal) * View.SkyLightColor.rgb;
