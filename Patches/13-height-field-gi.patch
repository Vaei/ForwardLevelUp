+		const float3 Albedo = SampleHeightTexel(HitXY).rgb;
+		Bounce += Weight * Occluded * Albedo * GetSurfaceLighting(float3(-Direction, 0), 1);
+		WeightSum += Weight;
+	}
+	Bounce /= max(WeightSum, 1e-4);
+
+	// Cosine weighted share of the lower hemisphere: none for a floor, half for a wall
+	const float GroundShare = 0.5 * (1 - Normal.z);
+	if (GroundShare > 0)
+	{
+		const float2 GroundXY = Position.xy + Normal.xy * NormalBias;
+		const float4 Ground = SampleHeightTexel(GroundXY);
+
+		float SunVisibility = 0;
+		const float SunHorizontal = length(SunDirection.xy);
+		if (SunDirection.z > 0)
+		{
+			float2 HitXY;
+			const float SunSlope = SunHorizontal > 1e-3 ? SearchHorizon(float3(GroundXY, Ground.a + 10), SunDirection.xy / SunHorizontal, HitXY) : 0;
+			SunVisibility = saturate((SunDirection.z / max(SunHorizontal, 1e-3) - SunSlope) * 4 + 0.5);
+		}
+		Bounce += GroundShare * Ground.rgb * GetSurfaceLighting(float3(0, 0, 1), SunVisibility);
+	}
+
+	OutColor = float4(Bounce * (Intensity * EdgeFade), 0);
+}
