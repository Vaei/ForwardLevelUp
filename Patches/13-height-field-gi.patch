+
+/** Runs at half resolution. The horizon each direction stops at is lit as a wall facing back along it; the ground under the receiver lights what faces down. */
+void MainGIPS(float4 SvPosition : SV_POSITION, out float4 OutColor : SV_Target0)
+{
+	OutColor = 0;
+	const int2 Pixel = int2(SvPosition.xy) * 2;
+	if (SceneDepthTexture.Load(int3(Pixel, 0)).r == FarDepthValue)
+	{
+		return;
+	}
+
+	const float3 Position = PixelToTranslatedWorld(Pixel);
+	const float3 Normal = ReconstructNormal(Pixel, Position);
+	const float3 Origin = Position + Normal * NormalBias;
+	const float EdgeFade = GetEdgeFade(Origin.xy);
+	if (EdgeFade <= 0)
