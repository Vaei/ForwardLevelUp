+
+FRDGTextureRef RenderMobileHeightFieldGI(FRDGBuilder& GraphBuilder, FScene* Scene, TArrayView<const FViewInfo> Views, FRDGTexture* SceneDepth)
+{
+	TRACE_CPUPROFILER_EVENT_SCOPE(MobileHeightFieldAO::RenderMobileHeightFieldGI);
+
+	const FMobileHeightFieldAOSceneExtension* Extension = MobileHeightFieldAO::GetExtension(Scene);
+	const float Intensity = CVarMobileHeightFieldGIIntensity.GetValueOnRenderThread();
+	if (!IsMobileHeightFieldGIEnabled() || !Extension || Intensity <= 0.0f || !SceneDepth)
+	{
+		return nullptr;
+	}
+
+	RDG_EVENT_SCOPE_STAT(GraphBuilder, MobileHeightFieldGI, "MobileHeightFieldGI");
+
+	// Bounced light is soft, so half resolution is plenty
+	const FIntPoint Extent = FIntPoint::DivideAndRoundUp(SceneDepth->Desc.Extent, 2);
+	FRDGTextureRef GITexture = GraphBuilder.CreateTexture(
+		FRDGTextureDesc::Create2D(Extent, PF_FloatR11G11B10, FClearValueBinding::Black, TexCreate_ShaderResource | TexCreate_RenderTargetable),
+		TEXT("MobileHeightFieldGI"));
+
+	FVector3f SunDirection = FVector3f::UpVector;
+	FVector3f SunIlluminance = FVector3f::ZeroVector;
+	if (const FLightSceneInfo* Sun = Scene->SimpleDirectionalLight)
+	{
+		SunDirection = FVector3f(-Sun->Proxy->GetDirection());
+		SunIlluminance = FVector3f(Sun->Proxy->GetColor());
+	}
+
+	const uint32 NumDirections = FMath::Clamp(CVarMobileHeightFieldGIDirections.GetValueOnRenderThread(), 1, 32);
+	const uint32 NumSteps = FMath::Clamp(CVarMobileHeightFieldGISteps.GetValueOnRenderThread(), 1, 32);
+	bool bRendered = false;
+
+	for (const FViewInfo& View : Views)
+	{
+		if (!MobileHeightFieldAO::ShouldRenderForView(View))
+		{
+			continue;
+		}
+
+		FMobileHeightFieldGIPS::FParameters* PassParameters = GraphBuilder.AllocParameters<FMobileHeightFieldGIPS::FParameters>();
+		MobileHeightFieldAO::SetupHeightField(GraphBuilder, *Extension, View, SceneDepth, NumDirections, NumSteps, PassParameters->HeightField);
+		PassParameters->SunDirection = SunDirection;
+		PassParameters->SunIlluminance = SunIlluminance;
+		PassParameters->Intensity = Intensity;
+		PassParameters->RenderTargets[0] = FRenderTargetBinding(GITexture, bRendered ? ERenderTargetLoadAction::ELoad : ERenderTargetLoadAction::EClear);
+		bRendered = true;
+
+		const FIntRect ViewRect(FIntPoint::DivideAndRoundDown(View.ViewRect.Min, 2), FIntPoint::DivideAndRoundUp(View.ViewRect.Max, 2));
+		TShaderMapRef<FMobileHeightFieldGIPS> PixelShader(View.ShaderMap);
+		FPixelShaderUtils::AddFullscreenPass(
+			GraphBuilder,
+			View.ShaderMap,
+			RDG_EVENT_NAME("HeightFieldGI %dx%d", ViewRect.Width(), ViewRect.Height()),
+			PixelShader,
+			PassParameters,
+			ViewRect);
+	}
+
+	return bRendered ? GITexture : nullptr;
+}
