+void SetupMobileProbeGIDummyParameters(FRDGBuilder& GraphBuilder, FMobileProbeGIUniformParameters& OutParameters)
+{
+	const FRDGSystemTextures& SystemTextures = FRDGSystemTextures::Get(GraphBuilder);
+	OutParameters.IrradianceAtlas = SystemTextures.Black;
+	OutParameters.DistanceAtlas = SystemTextures.Black;
+	OutParameters.AtlasSampler = TStaticSamplerState<SF_Bilinear, AM_Clamp, AM_Clamp, AM_Clamp>::GetRHI();
+	OutParameters.ProbeState = GraphBuilder.CreateSRV(GSystemTextures.GetDefaultBuffer(GraphBuilder, sizeof(uint32), 0u), PF_R32_UINT);
+	OutParameters.GridMinTranslated = FVector3f::ZeroVector;
+	OutParameters.Spacing = 1.0f;
+	OutParameters.GridSize = FIntVector(2, 2, 2);
+	OutParameters.TilesPerRow = 1;
+	OutParameters.GridMin = FIntVector::ZeroValue;
+	// Zero intensity makes the base pass skip the probes
+	OutParameters.Intensity = 0.0f;
+	OutParameters.IrradianceAtlasInvSize = FVector2f::UnitVector;
+	OutParameters.DistanceAtlasInvSize = FVector2f::UnitVector;
+	OutParameters.NormalBias = 0.0f;
+	OutParameters.ViewBias = 0.0f;
+}
