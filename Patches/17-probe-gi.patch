+/** Packs the local lights that can reach the grid for the tracer, nearest the camera first. Returns how many. */
+static uint32 GatherProbeLocalLights(FRDGBuilder& GraphBuilder, const FScene& Scene, const FViewInfo& View, const FBox& GridBounds, int32 MaxLights, FRDGBufferSRVRef& OutLights)
+{
+	TRACE_CPUPROFILER_EVENT_SCOPE(MobileProbeGI::GatherProbeLocalLights);
+
+	struct FCandidate
+	{
+		FLightRenderParameters Parameters;
+		double DistanceSqr;
+		bool bSpot;
+	};
+	TArray<FCandidate, SceneRenderingAllocator> Candidates;
+
+	if (MaxLights > 0)
+	{
+		const FVector ViewOrigin = View.ViewMatrices.GetViewOrigin();
+		for (const FLightSceneInfoCompact& LightCompact : Scene.Lights)
+		{
+			const FLightSceneInfo* LightSceneInfo = LightCompact.LightSceneInfo;
+			const uint8 LightType = LightCompact.LightType;
+			if (LightType == LightType_Directional || !LightSceneInfo->ShouldRenderLightViewIndependent())
+			{
+				continue;
+			}
+
+			const FSphere Bounds = LightSceneInfo->Proxy->GetBoundingSphere();
+			if (GridBounds.ComputeSquaredDistanceToPoint(Bounds.Center) > FMath::Square(Bounds.W))
+			{
+				continue;
+			}
+
+			FCandidate& Candidate = Candidates.AddDefaulted_GetRef();
+			LightSceneInfo->Proxy->GetLightShaderParameters(Candidate.Parameters);
+			Candidate.DistanceSqr = FVector::DistSquared(Bounds.Center, ViewOrigin);
+			Candidate.bSpot = LightType == LightType_Spot;
+		}
+
+		Candidates.Sort([](const FCandidate& A, const FCandidate& B) { return A.DistanceSqr < B.DistanceSqr; });
+		Candidates.SetNum(FMath::Min(Candidates.Num(), MaxLights), EAllowShrinking::No);
+	}
+
+	if (Candidates.IsEmpty())
+	{
+		OutLights = GraphBuilder.CreateSRV(GSystemTextures.GetDefaultStructuredBuffer(GraphBuilder, sizeof(FVector4f)));
+		return 0;
+	}
+
+	TArray<FVector4f, SceneRenderingAllocator> Data;
+	Data.Reserve(Candidates.Num() * 4);
+	const FVector PreViewTranslation = View.ViewMatrices.GetPreViewTranslation();
+	for (const FCandidate& Candidate : Candidates)
+	{
+		const FLightRenderParameters& Light = Candidate.Parameters;
+		Data.Emplace(FVector3f(Light.WorldPosition + PreViewTranslation), Light.InvRadius);
+		Data.Emplace(Light.Color.R, Light.Color.G, Light.Color.B, Light.FalloffExponent);
+		Data.Emplace(Light.Direction, Candidate.bSpot ? 1.0f : 0.0f);
+		Data.Emplace(Light.SpotAngles.X, Light.SpotAngles.Y, 0.0f, 0.0f);
+	}
+	OutLights = GraphBuilder.CreateSRV(CreateStructuredBuffer(GraphBuilder, TEXT("MobileProbeGI.LocalLights"), TConstArrayView<FVector4f>(Data)));
+	return Candidates.Num();
+}
+
+/** A random rotation per update, so successive updates cover directions between the previous rays. */
+static FMatrix44f MakeRayRotation(uint32 FrameIndex)
+{
+	FRandomStream Random(int32(FrameIndex * 2654435761u));
+	const FVector Axis = Random.GetUnitVector();
+	const float Angle = Random.FRandRange(0.0f, 2.0f * UE_PI);
+	return FMatrix44f(FQuat4f(FVector3f(Axis), Angle).ToMatrix());
+}
+
+void RenderMobileProbeGI(FRDGBuilder& GraphBuilder, const FSceneRenderer& SceneRenderer, const FViewInfo& View, FRDGTextureRef SceneDepth, FMobileProbeGIUniformParameters& OutParameters)
+{
+	TRACE_CPUPROFILER_EVENT_SCOPE(MobileProbeGI::RenderMobileProbeGI);
+
+	SetupMobileProbeGIDummyParameters(GraphBuilder, OutParameters);
+
+	FScene* Scene = SceneRenderer.Scene;
+	const float Intensity = CVarMobileProbeGIIntensity.GetValueOnRenderThread();
+	if (!Scene
+		|| !IsMobileProbeGIEnabled(View.GetShaderPlatform())
+		|| Intensity <= 0.0f
+		|| !View.ViewState
+		|| View.GlobalDistanceFieldInfo.Clipmaps.Num() == 0
+		|| !HasBeenProduced(SceneDepth))
+	{
+		return;
+	}
+
+	FMobileProbeGISceneExtension* Extension = Scene->GetExtensionPtr<FMobileProbeGISceneExtension>();
+	if (!Extension)
+	{
+		return;
+	}
+
+	RDG_EVENT_SCOPE(GraphBuilder, "MobileProbeGI");
+
+	const uint32 SceneFrame = Scene->GetFrameNumberRenderThread();
+	for (auto It = Extension->Volumes.CreateIterator(); It; ++It)
+	{
+		if (SceneFrame - It.Value().LastRenderedFrame > MobileProbeGI::StaleFrames)
+		{
+			It.RemoveCurrent();
+		}
+	}
+	FMobileProbeGISceneExtension::FVolume& Volume = Extension->Volumes.FindOrAdd(View.ViewState->GetViewKey());
+	Volume.LastRenderedFrame = SceneFrame;
+
+	const float Spacing = FMath::Max(CVarMobileProbeGISpacing.GetValueOnRenderThread(), 10.0f);
+	const int32 SizeXY = FMath::Clamp(CVarMobileProbeGIGridSizeXY.GetValueOnRenderThread(), 4, 64);
+	const int32 SizeZ = FMath::Clamp(CVarMobileProbeGIGridSizeZ.GetValueOnRenderThread(), 4, 32);
+	const FIntVector GridSize(SizeXY, SizeXY, SizeZ);
+	const int32 NumProbes = GridSize.X * GridSize.Y * GridSize.Z;
+	const uint32 NumRays = uint32(FMath::Clamp(FMath::DivideAndRoundUp(CVarMobileProbeGIRaysPerProbe.GetValueOnRenderThread(), 32) * 32, 32, 256));
+	const uint32 UpdateInterval = uint32(FMath::Clamp(CVarMobileProbeGIUpdateInterval.GetValueOnRenderThread(), 1, 16));
+
+	const FVector CameraPosition = View.ViewMatrices.GetViewOrigin();
+	const FIntVector CameraCoord(FMath::FloorToInt32(CameraPosition.X / Spacing), FMath::FloorToInt32(CameraPosition.Y / Spacing), FMath::FloorToInt32(CameraPosition.Z / Spacing));
+	const FIntVector GridMin = CameraCoord - GridSize / 2;
+
+	const bool bResetAll = !Volume.Irradiance || !Volume.Distance || !Volume.State || Volume.GridSize != GridSize || Volume.Spacing != Spacing;
+	const FIntVector PrevGridMin = bResetAll ? GridMin : Volume.GridMin;
+
+	const int32 TileRows = FMath::DivideAndRoundUp(NumProbes, MobileProbeGI::TilesPerRow);
+	const FIntPoint IrradianceExtent(MobileProbeGI::TilesPerRow * MobileProbeGI::IrradianceTile, TileRows * MobileProbeGI::IrradianceTile);
+	const FIntPoint DistanceExtent(MobileProbeGI::TilesPerRow * MobileProbeGI::DistanceTile, TileRows * MobileProbeGI::DistanceTile);
+
+	const FRDGSystemTextures& SystemTextures = FRDGSystemTextures::Get(GraphBuilder);
+	FRDGTextureRef HistoryIrradiance = bResetAll ? SystemTextures.Black : GraphBuilder.RegisterExternalTexture(Volume.Irradiance);
+	FRDGTextureRef HistoryDistance = bResetAll ? SystemTextures.Black : GraphBuilder.RegisterExternalTexture(Volume.Distance);
+	FRDGBufferRef PrevState = bResetAll
+		? GSystemTextures.GetDefaultBuffer(GraphBuilder, sizeof(uint32), 0u)
+		: GraphBuilder.RegisterExternalBuffer(Volume.State);
+
+	FRDGTextureRef Irradiance = GraphBuilder.CreateTexture(
+		FRDGTextureDesc::Create2D(IrradianceExtent, PF_FloatRGBA, FClearValueBinding::Black, TexCreate_ShaderResource | TexCreate_UAV), TEXT("MobileProbeGI.Irradiance"));
+	FRDGTextureRef Distance = GraphBuilder.CreateTexture(
+		FRDGTextureDesc::Create2D(DistanceExtent, PF_G16R16F, FClearValueBinding::Black, TexCreate_ShaderResource | TexCreate_UAV), TEXT("MobileProbeGI.Distance"));
+	FRDGBufferRef State = GraphBuilder.CreateBuffer(FRDGBufferDesc::CreateBufferDesc(sizeof(uint32), NumProbes), TEXT("MobileProbeGI.State"));
+	FRDGBufferRef RayData = GraphBuilder.CreateBuffer(FRDGBufferDesc::CreateBufferDesc(sizeof(FFloat16Color), NumProbes * NumRays), TEXT("MobileProbeGI.RayData"));
+
+	FMobileProbeGIUniformParameters SamplingParameters;
+	SamplingParameters.AtlasSampler = TStaticSamplerState<SF_Bilinear, AM_Clamp, AM_Clamp, AM_Clamp>::GetRHI();
+	SamplingParameters.GridMinTranslated = FVector3f(FVector(GridMin) * Spacing + View.ViewMatrices.GetPreViewTranslation());
+	SamplingParameters.Spacing = Spacing;
+	SamplingParameters.GridSize = GridSize;
+	SamplingParameters.TilesPerRow = MobileProbeGI::TilesPerRow;
+	SamplingParameters.GridMin = GridMin;
+	SamplingParameters.Intensity = Intensity;
+	SamplingParameters.IrradianceAtlasInvSize = FVector2f(1.0f / IrradianceExtent.X, 1.0f / IrradianceExtent.Y);
+	SamplingParameters.DistanceAtlasInvSize = FVector2f(1.0f / DistanceExtent.X, 1.0f / DistanceExtent.Y);
+	SamplingParameters.NormalBias = 0.2f;
+	SamplingParameters.ViewBias = 0.1f;
+
+	// Rays sample last frame's probes for the bounce after the first; the updates must not read the atlases they write
+	FMobileProbeGIUniformParameters* TraceUniformParameters = GraphBuilder.AllocParameters<FMobileProbeGIUniformParameters>(&SamplingParameters);
+	TraceUniformParameters->IrradianceAtlas = HistoryIrradiance;
+	TraceUniformParameters->DistanceAtlas = HistoryDistance;
+	TraceUniformParameters->ProbeState = GraphBuilder.CreateSRV(PrevState, PF_R32_UINT);
+	if (bResetAll)
+	{
+		TraceUniformParameters->Intensity = 0.0f;
+	}
+	TRDGUniformBufferRef<FMobileProbeGIUniformParameters> TraceUniformBuffer = GraphBuilder.CreateUniformBuffer(TraceUniformParameters);
+
+	FMobileProbeGIUniformParameters* UpdateUniformParameters = GraphBuilder.AllocParameters<FMobileProbeGIUniformParameters>(&SamplingParameters);
+	UpdateUniformParameters->IrradianceAtlas = SystemTextures.Black;
+	UpdateUniformParameters->DistanceAtlas = SystemTextures.Black;
+	UpdateUniformParameters->ProbeState = GraphBuilder.CreateSRV(GSystemTextures.GetDefaultBuffer(GraphBuilder, sizeof(uint32), 0u), PF_R32_UINT);
+	TRDGUniformBufferRef<FMobileProbeGIUniformParameters> UpdateUniformBuffer = GraphBuilder.CreateUniformBuffer(UpdateUniformParameters);
+
+	const FMatrix44f RayRotation = MakeRayRotation(Volume.FrameIndex);
+	FMobileProbeGICommonParameters Common;
+	Common.PrevProbeState = GraphBuilder.CreateSRV(PrevState, PF_R32_UINT);
+	Common.PrevGridMin = PrevGridMin;
+	Common.bResetAll = bResetAll ? 1 : 0;
+	Common.NumRays = NumRays;
+	Common.FrameIndex = Volume.FrameIndex;
+	Common.UpdateInterval = UpdateInterval;
+	Common.RayRotation0 = FVector4f(RayRotation.M[0][0], RayRotation.M[1][0], RayRotation.M[2][0], 0.0f);
+	Common.RayRotation1 = FVector4f(RayRotation.M[0][1], RayRotation.M[1][1], RayRotation.M[2][1], 0.0f);
+	Common.RayRotation2 = FVector4f(RayRotation.M[0][2], RayRotation.M[1][2], RayRotation.M[2][2], 0.0f);
+
+	{
+		FMobileProbeGITraceCS::FParameters* PassParameters = GraphBuilder.AllocParameters<FMobileProbeGITraceCS::FParameters>();
+		PassParameters->View = View.ViewUniformBuffer;
+		PassParameters->Common = Common;
+		PassParameters->Common.MobileProbeGI = TraceUniformBuffer;
+		const FIntVector GroupCount = GetWrappedGroupCount(FMath::DivideAndRoundUp(NumProbes * int32(NumRays), MobileProbeGI::ThreadGroupSize));
+		PassParameters->Common.DispatchGroupsX = GroupCount.X;
+		PassParameters->GlobalDistanceFieldParameters = SetupGlobalDistanceFieldParameters(View.GlobalDistanceFieldInfo.ParameterData);
+		PassParameters->RWRayData = GraphBuilder.CreateUAV(RayData, PF_FloatRGBA);
+		PassParameters->MaxTraceDistance = FMath::Max(CVarMobileProbeGIMaxTraceDistance.GetValueOnRenderThread(), Spacing);
+		PassParameters->DefaultAlbedo = FMath::Clamp(CVarMobileProbeGIAlbedo.GetValueOnRenderThread(), 0.0f, 1.0f);
+		PassParameters->SunShadowDistance = PassParameters->MaxTraceDistance;
+		PassParameters->SceneDepthTexture = SceneDepth;
+
+		PassParameters->SunDirection = FVector3f::UpVector;
+		PassParameters->SunColor = FVector3f::ZeroVector;
+		const FBox GridBounds(FVector(GridMin) * Spacing, FVector(GridMin + GridSize) * Spacing);
+		PassParameters->NumLocalLights = GatherProbeLocalLights(GraphBuilder, *Scene, View, GridBounds, CVarMobileProbeGILocalLights.GetValueOnRenderThread(), PassParameters->LocalLights);
+		PassParameters->bLocalLightShadows = CVarMobileProbeGILocalLightShadows.GetValueOnRenderThread() != 0 ? 1 : 0;
+
+		if (const FLightSceneInfo* SunLight = Scene->MobileDirectionalLights[0])
+		{
+			const FLightSceneProxy* Proxy = SunLight->Proxy;
+			PassParameters->SunDirection = FVector3f(-Proxy->GetDirection());
+			const FLinearColor SunColor = Proxy->IsUsedAsAtmosphereSunLight()
+				? Proxy->GetSunIlluminanceAccountingForSkyAtmospherePerPixelTransmittance()
+				: Proxy->GetColor();
+			PassParameters->SunColor = FVector3f(SunColor.R, SunColor.G, SunColor.B);
+		}
+
+		const bool bScreenRadiance = CVarMobileProbeGIScreenRadiance.GetValueOnRenderThread() != 0
+			&& View.PrevViewInfo.TemporalAAHistory.IsValid()
+			&& !View.bCameraCut;
+		PassParameters->bScreenRadiance = bScreenRadiance ? 1 : 0;
+		PassParameters->PrevSceneColorTexture = SystemTextures.Black;
+		PassParameters->PrevSceneColorSampler = TStaticSamplerState<SF_Bilinear, AM_Clamp, AM_Clamp, AM_Clamp>::GetRHI();
+		PassParameters->PrevScreenPositionScaleBias = FVector4f(0.5f, -0.5f, 0.5f, 0.5f);
+		PassParameters->PrevPreExposureInv = 1.0f;
+		if (bScreenRadiance)
+		{
+			const FTemporalAAHistory& History = View.PrevViewInfo.TemporalAAHistory;
+			FRDGTextureRef PrevSceneColor = GraphBuilder.RegisterExternalTexture(History.RT[0]);
+			if (!PrevSceneColor->Desc.IsTextureArray())
+			{
+				PassParameters->PrevSceneColorTexture = PrevSceneColor;
+				const FIntPoint ViewportOffset = History.ViewportRect.Min;
+				const FIntPoint ViewportExtent = History.ViewportRect.Size();
+				const FVector2f InvBufferSize(1.0f / FMath::Max(History.ReferenceBufferSize.X, 1), 1.0f / FMath::Max(History.ReferenceBufferSize.Y, 1));
+				PassParameters->PrevScreenPositionScaleBias = FVector4f(
+					ViewportExtent.X * 0.5f * InvBufferSize.X,
+					-ViewportExtent.Y * 0.5f * InvBufferSize.Y,
+					(ViewportExtent.X * 0.5f + ViewportOffset.X) * InvBufferSize.X,
+					(ViewportExtent.Y * 0.5f + ViewportOffset.Y) * InvBufferSize.Y);
+				PassParameters->PrevPreExposureInv = 1.0f / FMath::Max(View.PrevViewInfo.SceneColorPreExposure, UE_SMALL_NUMBER);
+			}
+			else
+			{
+				PassParameters->bScreenRadiance = 0;
+			}
+		}
+
+		TShaderMapRef<FMobileProbeGITraceCS> ComputeShader(View.ShaderMap);
+		FComputeShaderUtils::AddPass(
+			GraphBuilder,
+			RDG_EVENT_NAME("Trace %d probes x %d rays", NumProbes, NumRays),
+			ComputeShader,
+			PassParameters,
+			GroupCount);
+	}
+
+	const float Hysteresis = FMath::Clamp(CVarMobileProbeGIHysteresis.GetValueOnRenderThread(), 0.0f, 0.99f);
+	for (int32 Pass = 0; Pass < 2; ++Pass)
+	{
+		const bool bDistance = Pass == 1;
+		FMobileProbeGIUpdateCS::FParameters* PassParameters = GraphBuilder.AllocParameters<FMobileProbeGIUpdateCS::FParameters>();
+		PassParameters->Common = Common;
+		PassParameters->Common.MobileProbeGI = UpdateUniformBuffer;
+		const FIntVector GroupCount = GetWrappedGroupCount(NumProbes);
+		PassParameters->Common.DispatchGroupsX = GroupCount.X;
+		PassParameters->RayData = GraphBuilder.CreateSRV(RayData, PF_FloatRGBA);
+		PassParameters->HistoryAtlas = bDistance ? HistoryDistance : HistoryIrradiance;
+		PassParameters->RWAtlas = GraphBuilder.CreateUAV(bDistance ? Distance : Irradiance);
+		PassParameters->Hysteresis = Hysteresis;
+		PassParameters->MaxProbeDistance = Spacing * 1.5f;
+		PassParameters->TileTexels = bDistance ? MobileProbeGI::DistanceTexels : MobileProbeGI::IrradianceTexels;
+
+		FMobileProbeGIUpdateCS::FPermutationDomain PermutationVector;
+		PermutationVector.Set<FMobileProbeGIUpdateCS::FUpdateDistance>(bDistance);
+		TShaderMapRef<FMobileProbeGIUpdateCS> ComputeShader(View.ShaderMap, PermutationVector);
+		FComputeShaderUtils::AddPass(
+			GraphBuilder,
+			bDistance ? RDG_EVENT_NAME("UpdateDistance") : RDG_EVENT_NAME("UpdateIrradiance"),
+			ComputeShader,
+			PassParameters,
+			GroupCount);
+	}
+
+	{
+		FMobileProbeGIFinalizeCS::FParameters* PassParameters = GraphBuilder.AllocParameters<FMobileProbeGIFinalizeCS::FParameters>();
+		PassParameters->Common = Common;
+		PassParameters->Common.MobileProbeGI = UpdateUniformBuffer;
+		const FIntVector GroupCount = GetWrappedGroupCount(FMath::DivideAndRoundUp(NumProbes, MobileProbeGI::ThreadGroupSize));
+		PassParameters->Common.DispatchGroupsX = GroupCount.X;
+		PassParameters->RayData = GraphBuilder.CreateSRV(RayData, PF_FloatRGBA);
+		PassParameters->RWProbeState = GraphBuilder.CreateUAV(State, PF_R32_UINT);
+
+		TShaderMapRef<FMobileProbeGIFinalizeCS> ComputeShader(View.ShaderMap);
+		FComputeShaderUtils::AddPass(
+			GraphBuilder,
+			RDG_EVENT_NAME("Finalize"),
+			ComputeShader,
+			PassParameters,
+			GroupCount);
+	}
+
+	GraphBuilder.QueueTextureExtraction(Irradiance, &Volume.Irradiance);
+	GraphBuilder.QueueTextureExtraction(Distance, &Volume.Distance);
+	GraphBuilder.QueueBufferExtraction(State, &Volume.State);
+	Volume.GridMin = GridMin;
+	Volume.GridSize = GridSize;
+	Volume.Spacing = Spacing;
+	++Volume.FrameIndex;
+
+	OutParameters = SamplingParameters;
+	OutParameters.IrradianceAtlas = Irradiance;
+	OutParameters.DistanceAtlas = Distance;
+	OutParameters.ProbeState = GraphBuilder.CreateSRV(State, PF_R32_UINT);
+}
