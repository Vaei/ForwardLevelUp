+/** Groups wrapped onto two dimensions under the per-dimension limit; the shaders rebuild the linear index with DispatchGroupsX. */
+static FIntVector GetWrappedGroupCount(int32 NumGroups)
+{
+	const int32 GroupsX = FMath::Clamp(NumGroups, 1, 32768);
+	return FIntVector(GroupsX, FMath::DivideAndRoundUp(NumGroups, GroupsX), 1);
+}
