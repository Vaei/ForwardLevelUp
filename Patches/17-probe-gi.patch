+// Copyright (c) 2026 Jared Taylor.
+
+#pragma once
+
+#include "CoreMinimal.h"
+#include "RenderGraphFwd.h"
+#include "RHIShaderPlatform.h"
+#include "ShaderParameterMacros.h"
+
+class FScene;
+class FSceneRenderer;
+struct FShaderCompilerEnvironment;
+class FViewInfo;
+
+/** A grid of irradiance probes around the camera, sampled by the mobile forward base pass. Storage is toroidal, so probes keep their history as the grid scrolls. */
+BEGIN_GLOBAL_SHADER_PARAMETER_STRUCT(FMobileProbeGIUniformParameters, )
+	SHADER_PARAMETER_RDG_TEXTURE(Texture2D, IrradianceAtlas)
+	SHADER_PARAMETER_RDG_TEXTURE(Texture2D, DistanceAtlas)
+	SHADER_PARAMETER_SAMPLER(SamplerState, AtlasSampler)
+	SHADER_PARAMETER_RDG_BUFFER_SRV(Buffer<uint>, ProbeState)
+	SHADER_PARAMETER(FVector3f, GridMinTranslated)
+	SHADER_PARAMETER(float, Spacing)
+	SHADER_PARAMETER(FIntVector, GridSize)
+	SHADER_PARAMETER(uint32, TilesPerRow)
+	SHADER_PARAMETER(FIntVector, GridMin)
+	SHADER_PARAMETER(float, Intensity)
+	SHADER_PARAMETER(FVector2f, IrradianceAtlasInvSize)
+	SHADER_PARAMETER(FVector2f, DistanceAtlasInvSize)
+	SHADER_PARAMETER(float, NormalBias)
+	SHADER_PARAMETER(float, ViewBias)
+END_GLOBAL_SHADER_PARAMETER_STRUCT()
+
+/** Whether r.Mobile.ProbeGI compiles probe sampling into the mobile forward base pass. */
+bool IsMobileProbeGIEnabled(EShaderPlatform Platform);
+
+/** Sets the base pass defines that sample the probes, for opaque and masked materials on mobile forward. */
+void SetMobileProbeGIBasePassDefines(EShaderPlatform Platform, bool bTranslucentMaterial, FShaderCompilerEnvironment& OutEnvironment);
+
+/** Parameters that make the base pass sample nothing, for frames without probes. */
+void SetupMobileProbeGIDummyParameters(FRDGBuilder& GraphBuilder, FMobileProbeGIUniformParameters& OutParameters);
+
+/**
+ * Traces and updates this frame's share of the view's probes against the global distance field, then fills the parameters the
+ * base pass samples them with. Needs the resolved prepass depth, which decides when a ray hit can take last frame's lit colour.
+ */
+void RenderMobileProbeGI(FRDGBuilder& GraphBuilder, const FSceneRenderer& SceneRenderer, const FViewInfo& View, FRDGTextureRef SceneDepth, FMobileProbeGIUniformParameters& OutParameters);
diff --git a/Engine/Source/Runtime/Renderer/Private/MobileShadingRenderer.cpp b/Engine/Source/Runtime/Renderer/Private/MobileShadingRenderer.cpp
index 7d41c383a2aa..50d9c2c4872c 100644
--- a/Engine/Source/Runtime/Renderer/Private/MobileShadingRenderer.cpp
+++ b/Engine/Source/Runtime/Renderer/Private/MobileShadingRenderer.cpp
@@ -1798,6 +1798,13 @@ void FMobileSceneRenderer::Render(FRDGBuilder& GraphBuilder, const FSceneRenderU
 			BasePassTextures.HeightFieldGITexture = RenderMobileHeightFieldGI(GraphBuilder, Scene, Views, SceneTextures.Depth.Resolve);
 		}
 
+		if (bRendererOutputFinalSceneColor && IsMobileProbeGIEnabled(ShaderPlatform) && Views.Num() > 0)
+		{
+			// The probes follow the first view; further views sample the same grid
+			RenderMobileProbeGI(GraphBuilder, *this, Views[0], SceneTextures.Depth.Resolve, BasePassTextures.ProbeGI);
+			BasePassTextures.bHasProbeGI = true;
+		}
+
 		// When renderer is in ERendererOutput::DepthPrepassOnly mode, bRequiresShadowProjections is set to false in InitViews()
 		if (bRequiresShadowProjections)
 		{
