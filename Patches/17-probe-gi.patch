diff --git a/Engine/Shaders/Private/MobileProbeGI.usf b/Engine/Shaders/Private/MobileProbeGI.usf
new file mode 100644
index 000000000000..6b755e2fab29
--- /dev/null
+++ b/Engine/Shaders/Private/MobileProbeGI.usf
@@ -0,0 +1,364 @@
+// Copyright (c) 2026 Jared Taylor.
+
+#include "Common.ush"
+
+#define ProbeGI MobileProbeGI
+#include "MobileProbeGICommon.ush"
+
+#ifndef THREADGROUP_SIZE
+#define THREADGROUP_SIZE 64
+#endif
+
+#define MAX_PROBE_GI_RAYS 256
+
+Buffer<uint> PrevProbeState;
+int3 PrevGridMin;
+uint bResetAll;
+uint NumRays;
+uint FrameIndex;
+uint UpdateInterval;
+uint DispatchGroupsX;
+
+/** Group index of a dispatch wrapped onto two dimensions, which large grids need to stay under the group count limit. */
+uint GetLinearGroupIndex(uint3 GroupId)
+{
+	return GroupId.y * DispatchGroupsX + GroupId.x;
+}
+
+/** RESET for a probe that scrolled to a new world position since last frame, or for every probe after a reset. */
+uint GetEffectiveProbeState(uint StorageIndex)
+{
+	if (bResetAll != 0)
+	{
+		return PROBE_GI_STATE_RESET;
+	}
+
+	const int3 Size = ProbeGI.GridSize;
+	const int3 Storage = int3(StorageIndex % Size.x, (StorageIndex / Size.x) % Size.y, StorageIndex / (Size.x * Size.y));
+	const int3 WorldNow = ProbeGI.GridMin + ProbeGIPositiveMod(Storage - ProbeGI.GridMin, Size);
+	const int3 WorldPrev = PrevGridMin + ProbeGIPositiveMod(Storage - PrevGridMin, Size);
+	return any(WorldNow != WorldPrev) ? PROBE_GI_STATE_RESET : PrevProbeState[StorageIndex];
+}
+
+/** A fraction of the probes update each frame, round robin, plus every probe that has no history. */
+bool IsProbeScheduled(uint StorageIndex, uint EffectiveState)
+{
+	return EffectiveState == PROBE_GI_STATE_RESET || ((StorageIndex + FrameIndex) % UpdateInterval) == 0;
+}
+
+uint GetNumProbes()
+{
+	// Spelled out rather than through ProbeGI: the engine finds a shader's uniform buffers by their name followed by a dot
+	return uint(MobileProbeGI.GridSize.x * MobileProbeGI.GridSize.y * MobileProbeGI.GridSize.z);
+}
+
+float4 RayRotation0;
+float4 RayRotation1;
+float4 RayRotation2;
+
+float3 GetRayDirection(uint RayIndex)
+{
+	// Spherical Fibonacci, rotated randomly each frame so the probes converge over many directions
+	const float GoldenAngle = 2.39996323f;
+	const float Z = 1.0f - (2.0f * RayIndex + 1.0f) / float(NumRays);
+	const float Radius = sqrt(saturate(1.0f - Z * Z));
+	const float Phi = RayIndex * GoldenAngle;
+	const float3 Local = float3(Radius * cos(Phi), Radius * sin(Phi), Z);
+	return normalize(float3(dot(RayRotation0.xyz, Local), dot(RayRotation1.xyz, Local), dot(RayRotation2.xyz, Local)));
+}
+
+#if SHADER_TRACE
+
+#include "DistanceField/GlobalDistanceFieldShared.ush"
+#include "DistanceField/GlobalDistanceFieldUtils.ush"
+
+RWBuffer<float4> RWRayData;
+float MaxTraceDistance;
+float3 SunDirection;
+float3 SunColor;
+float DefaultAlbedo;
+float SunShadowDistance;
+
+// Four float4 per light: translated position and inverse radius, colour and falloff exponent, direction and spot flag, spot angles
+#define PROBE_GI_LIGHT_STRIDE 4
+StructuredBuffer<float4> LocalLights;
+uint NumLocalLights;
+uint bLocalLightShadows;
+
+Texture2D SceneDepthTexture;
+Texture2D PrevSceneColorTexture;
+SamplerState PrevSceneColorSampler;
+float4 PrevScreenPositionScaleBias;
+float PrevPreExposureInv;
+uint bScreenRadiance;
+
+bool TraceGlobalSDF(float3 Origin, float3 Direction, float MaxDistance, out float HitTime, out uint HitClipmapIndex)
+{
+	FGlobalSDFTraceInput TraceInput = SetupGlobalSDFTraceInput(Origin, Direction, 0.0f, MaxDistance, 1.0f, 1.0f);
+	const FGlobalSDFTraceResult TraceResult = RayTraceGlobalDistanceField(TraceInput);
+	HitTime = TraceResult.HitTime;
+	HitClipmapIndex = TraceResult.HitClipmapIndex;
+	return GlobalSDFTraceResultIsHit(TraceResult);
+}
+
+/** Last frame's lit colour where the hit is on screen and not hidden behind something nearer: true outgoing radiance, emissive and local lights included. */
+bool GetScreenRadiance(float3 HitPosition, out float3 Radiance)
+{
+	Radiance = 0;
+	if (bScreenRadiance == 0)
+	{
+		return false;
+	}
+
+	const float4 Clip = mul(float4(HitPosition, 1.0f), View.TranslatedWorldToClip);
+	if (Clip.w <= 0.0f)
+	{
+		return false;
+	}
+	const float2 ScreenPosition = Clip.xy / Clip.w;
+	if (any(abs(ScreenPosition) >= 1.0f))
+	{
+		return false;
+	}
+
+	const float2 BufferUV = ScreenPosition * View.ScreenPositionScaleBias.xy + View.ScreenPositionScaleBias.wz;
+	const float SceneDeviceZ = SceneDepthTexture.Load(int3(BufferUV * View.BufferSizeAndInvSize.xy, 0)).r;
+	const float SceneDepth = ConvertFromDeviceZ(SceneDeviceZ);
+	if (abs(SceneDepth - Clip.w) > max(Clip.w * 0.03f, ProbeGI.Spacing * 0.25f))
+	{
+		return false;
+	}
+
+	const float4 PrevClip = mul(float4(ScreenPosition, SceneDeviceZ, 1.0f), View.ClipToPrevClip);
+	const float2 PrevScreen = PrevClip.xy / PrevClip.w;
+	if (any(abs(PrevScreen) >= 1.0f))
+	{
+		return false;
+	}
+	const float2 PrevUV = PrevScreen * PrevScreenPositionScaleBias.xy + PrevScreenPositionScaleBias.zw;
+	Radiance = PrevSceneColorTexture.SampleLevel(PrevSceneColorSampler, PrevUV, 0).rgb * PrevPreExposureInv;
+	return true;
+}
+
+/** Diffuse light the point, spot and rect lights around the grid leave on an off-screen hit, shadowed through the distance field. */
+float3 GetLocalLightIrradiance(float3 HitPosition, float3 HitNormal, float3 ShadowOrigin)
+{
+	float3 Irradiance = 0;
+	for (uint LightIndex = 0; LightIndex < NumLocalLights; ++LightIndex)
+	{
+		const float4 PositionAndInvRadius = LocalLights[LightIndex * PROBE_GI_LIGHT_STRIDE];
+		const float3 ToLight = PositionAndInvRadius.xyz - HitPosition;
+		const float DistanceSqr = dot(ToLight, ToLight);
+		const float NormalizedDistanceSqr = DistanceSqr * Square(PositionAndInvRadius.w);
+		if (NormalizedDistanceSqr >= 1.0f)
+		{
+			continue;
+		}
+
+		const float Distance = sqrt(DistanceSqr);
+		const float3 L = ToLight / max(Distance, 0.001f);
+		const float NoL = saturate(dot(HitNormal, L));
+		if (NoL <= 0.0f)
+		{
+			continue;
+		}
+
+		const float4 ColorAndFalloff = LocalLights[LightIndex * PROBE_GI_LIGHT_STRIDE + 1];
+		const float4 DirectionAndSpot = LocalLights[LightIndex * PROBE_GI_LIGHT_STRIDE + 2];
+		// Inverse square falloff when the exponent is zero, the same two models the lights shade surfaces with
+		float Attenuation = ColorAndFalloff.w == 0.0f
+			? Square(saturate(1.0f - Square(NormalizedDistanceSqr))) / (DistanceSqr + 1.0f)
+			: pow(1.0f - NormalizedDistanceSqr, ColorAndFalloff.w);
+		if (DirectionAndSpot.w > 0.0f)
+		{
+			const float2 SpotAngles = LocalLights[LightIndex * PROBE_GI_LIGHT_STRIDE + 3].xy;
+			Attenuation *= Square(saturate((dot(L, -DirectionAndSpot.xyz) - SpotAngles.x) * SpotAngles.y));
+		}
+		if (Attenuation <= 0.0001f)
+		{
+			continue;
+		}
+
+		float ShadowHitTime;
+		uint ShadowClipmapIndex;
+		if (bLocalLightShadows != 0 && TraceGlobalSDF(ShadowOrigin, L, Distance, ShadowHitTime, ShadowClipmapIndex) && ShadowHitTime < Distance * 0.95f)
+		{
+			continue;
+		}
+		Irradiance += ColorAndFalloff.rgb * (Attenuation * NoL);
+	}
+	return Irradiance;
+}
+
+[numthreads(THREADGROUP_SIZE, 1, 1)]
+void TraceCS(uint3 GroupId : SV_GroupID, uint GroupIndex : SV_GroupIndex)
+{
+	const uint DispatchThreadId = GetLinearGroupIndex(GroupId) * THREADGROUP_SIZE + GroupIndex;
+	const uint ProbeIndex = DispatchThreadId / NumRays;
+	const uint RayIndex = DispatchThreadId % NumRays;
+	if (ProbeIndex >= GetNumProbes() || !IsProbeScheduled(ProbeIndex, GetEffectiveProbeState(ProbeIndex)))
+	{
+		return;
+	}
+
+	const float3 ProbePosition = ProbeGITranslatedPosition(ProbeGILocalCoord(ProbeIndex));
+	const float3 Direction = GetRayDirection(RayIndex);
+
+	float HitTime;
+	uint HitClipmapIndex;
+	float4 Result;
+	if (TraceGlobalSDF(ProbePosition, Direction, MaxTraceDistance, HitTime, HitClipmapIndex))
+	{
+		const float3 HitPosition = ProbePosition + Direction * HitTime;
+		const float3 HitNormal = ComputeGlobalDistanceFieldNormal(HitPosition, HitClipmapIndex, -Direction);
+
+		// A hit at the ray's start means the probe is inside geometry, where the distance field has no useful normal
+		if (dot(HitNormal, Direction) > 0.0f || HitTime < ProbeGI.Spacing * 0.05f)
+		{
+			// The probe sees the inside of a surface. Negative distance counts it for the inside-geometry test.
+			Result = float4(0, 0, 0, -HitTime * 0.2f);
+		}
+		else
+		{
+			float3 Radiance;
+			if (!GetScreenRadiance(HitPosition, Radiance))
+			{
+				const float VoxelSize = GlobalVolumeTranslatedCenterAndExtent[HitClipmapIndex].w * GlobalVolumeTexelSize;
+				const float3 ShadowOrigin = HitPosition + HitNormal * VoxelSize * 2.0f;
+				float ShadowHitTime;
+				uint ShadowClipmapIndex;
+				const float NoL = saturate(dot(HitNormal, SunDirection));
+				const float SunVisibility = NoL > 0.0f && !TraceGlobalSDF(ShadowOrigin, SunDirection, SunShadowDistance, ShadowHitTime, ShadowClipmapIndex) ? 1.0f : 0.0f;
+
+				// Lambertian hit of unknown colour: direct sun and local lights, plus last frame's probes for further bounces
+				const float3 Direct = SunColor * NoL * SunVisibility + GetLocalLightIrradiance(HitPosition, HitNormal, ShadowOrigin);
+				const float3 Bounce = SampleMobileProbeGI(HitPosition, HitNormal, -Direction).rgb;
+				Radiance = DefaultAlbedo * (Direct / PI + Bounce);
+			}
+			Result = float4(Radiance, HitTime);
+		}
+	}
+	else
+	{
+		Result = float4(ProbeGISkyRadiance(Direction), MaxTraceDistance);
+	}
+
+	RWRayData[ProbeIndex * NumRays + RayIndex] = Result;
+}
+
+#endif // SHADER_TRACE
+
+#if SHADER_UPDATE
+
+Buffer<float4> RayData;
+Texture2D HistoryAtlas;
+RWTexture2D<float4> RWAtlas;
+float Hysteresis;
+float MaxProbeDistance;
+uint TileTexels;
+
+groupshared float4 SharedRays[MAX_PROBE_GI_RAYS];
+groupshared float3 SharedRayDirections[MAX_PROBE_GI_RAYS];
+
+/** The interior texel a border texel mirrors, so bilinear lookups wrap across the octahedral seams. */
+uint2 GetSourceTexel(uint2 TileTexel)
+{
+	const uint N = TileTexels;
+	uint2 Texel = TileTexel;
+	const bool bLeft = Texel.x == 0, bRight = Texel.x == N + 1, bTop = Texel.y == 0, bBottom = Texel.y == N + 1;
+	if ((bLeft || bRight) && (bTop || bBottom))
+	{
+		return uint2(bLeft ? N : 1, bTop ? N : 1);
+	}
+	if (bTop || bBottom)
+	{
+		return uint2(N + 1 - Texel.x, bTop ? 1 : N);
+	}
+	if (bLeft || bRight)
+	{
+		return uint2(bLeft ? 1 : N, N + 1 - Texel.y);
+	}
+	return Texel;
+}
+
+[numthreads(TILE_SIZE, TILE_SIZE, 1)]
+void UpdateCS(uint3 GroupId : SV_GroupID, uint3 GroupThreadId : SV_GroupThreadID, uint GroupIndex : SV_GroupIndex)
+{
+	const uint ProbeIndex = GetLinearGroupIndex(GroupId);
+	if (ProbeIndex >= GetNumProbes())
+	{
+		return;
+	}
+	const uint2 AtlasTexel = ProbeGITileOrigin(ProbeIndex, TILE_SIZE) + GroupThreadId.xy;
+	const uint EffectiveState = GetEffectiveProbeState(ProbeIndex);
+	if (!IsProbeScheduled(ProbeIndex, EffectiveState))
+	{
+		RWAtlas[AtlasTexel] = HistoryAtlas.Load(int3(AtlasTexel, 0));
+		return;
+	}
+
+	for (uint RayIndex = GroupIndex; RayIndex < NumRays; RayIndex += TILE_SIZE * TILE_SIZE)
+	{
+		SharedRays[RayIndex] = RayData[ProbeIndex * NumRays + RayIndex];
+		SharedRayDirections[RayIndex] = GetRayDirection(RayIndex);
+	}
+	GroupMemoryBarrierWithGroupSync();
+
+	const uint2 SourceTexel = GetSourceTexel(GroupThreadId.xy);
+	const float3 TexelDirection = OctahedronToUnitVector((float2(SourceTexel) - 0.5f) / float(TileTexels) * 2.0f - 1.0f);
+
+	float4 Sum = 0;
+	for (uint Ray = 0; Ray < NumRays; ++Ray)
+	{
+		const float4 RayResult = SharedRays[Ray];
+		const float CosTheta = dot(TexelDirection, SharedRayDirections[Ray]);
+#if UPDATE_DISTANCE
+		const float Weight = pow(saturate(CosTheta), 50.0f);
+		const float Distance = min(abs(RayResult.w), MaxProbeDistance);
+		Sum += float4(Distance, Distance * Distance, 0, 0) * Weight;
+		Sum.w += Weight;
+#else
+		// Rays that hit the inside of a surface carry no light
+		const float Weight = RayResult.w < 0.0f ? 0.0f : saturate(CosTheta);
+		Sum += float4(RayResult.rgb * Weight, Weight);
+#endif
+	}
+
+	const float4 New = Sum.w > 0.0001f ? float4(Sum.xyz / Sum.w, 1) : float4(0, 0, 0, 1);
+	const float4 History = HistoryAtlas.Load(int3(AtlasTexel, 0));
+	RWAtlas[AtlasTexel] = EffectiveState == PROBE_GI_STATE_RESET ? New : lerp(New, History, Hysteresis);
+}
+
+#endif // SHADER_UPDATE
+
+#if SHADER_FINALIZE
+
+Buffer<float4> RayData;
+RWBuffer<uint> RWProbeState;
+
+[numthreads(THREADGROUP_SIZE, 1, 1)]
+void FinalizeCS(uint3 GroupId : SV_GroupID, uint GroupIndex : SV_GroupIndex)
+{
+	const uint ProbeIndex = GetLinearGroupIndex(GroupId) * THREADGROUP_SIZE + GroupIndex;
+	if (ProbeIndex >= GetNumProbes())
+	{
+		return;
+	}
+
+	const uint EffectiveState = GetEffectiveProbeState(ProbeIndex);
+	if (!IsProbeScheduled(ProbeIndex, EffectiveState))
+	{
+		RWProbeState[ProbeIndex] = EffectiveState;
+		return;
+	}
+
+	uint Backfaces = 0;
+	for (uint Ray = 0; Ray < NumRays; ++Ray)
+	{
+		Backfaces += RayData[ProbeIndex * NumRays + Ray].w < 0.0f ? 1 : 0;
+	}
+	// A probe that sees the inside of surfaces in more than a few directions sits in or against geometry, where it leaks
+	RWProbeState[ProbeIndex] = Backfaces * 10 > NumRays ? PROBE_GI_STATE_INSIDE : PROBE_GI_STATE_VALID;
+}
+
+#endif // SHADER_FINALIZE
diff --git a/Engine/Shaders/Private/MobileProbeGICommon.ush b/Engine/Shaders/Private/MobileProbeGICommon.ush
new file mode 100644
index 000000000000..2ab904e552d7
--- /dev/null
+++ b/Engine/Shaders/Private/MobileProbeGICommon.ush
@@ -0,0 +1,147 @@
+// Copyright (c) 2026 Jared Taylor.
+
+#pragma once
+
+#include "OctahedralCommon.ush"
+
+// Each probe's tile holds an octahedral map with a one-texel border, so bilinear filtering never crosses into a neighbour
+#define PROBE_GI_IRRADIANCE_TEXELS 6
+#define PROBE_GI_DISTANCE_TEXELS 8
+#define PROBE_GI_IRRADIANCE_TILE (PROBE_GI_IRRADIANCE_TEXELS + 2)
+#define PROBE_GI_DISTANCE_TILE (PROBE_GI_DISTANCE_TEXELS + 2)
+
+#define PROBE_GI_STATE_RESET 0
+#define PROBE_GI_STATE_INSIDE 1
+#define PROBE_GI_STATE_VALID 2
+
+#ifndef ProbeGI
+#define ProbeGI MobileBasePass.ProbeGI
+#endif
+
+int3 ProbeGIPositiveMod(int3 Value, int3 Size)
+{
+	return ((Value % Size) + Size) % Size;
+}
+
+/** Linear index of the probe stored for the grid-local coordinate. Storage is toroidal, so probes keep their data while the grid scrolls. */
+uint ProbeGIStorageIndex(int3 LocalCoord)
+{
+	const int3 Storage = ProbeGIPositiveMod(ProbeGI.GridMin + LocalCoord, ProbeGI.GridSize);
+	return uint(Storage.x + Storage.y * ProbeGI.GridSize.x + Storage.z * ProbeGI.GridSize.x * ProbeGI.GridSize.y);
+}
+
+/** Grid-local coordinate of a storage index under the current grid origin. */
+int3 ProbeGILocalCoord(uint StorageIndex)
+{
+	const int3 Size = ProbeGI.GridSize;
+	const int3 Storage = int3(StorageIndex % Size.x, (StorageIndex / Size.x) % Size.y, StorageIndex / (Size.x * Size.y));
+	return ProbeGIPositiveMod(Storage - ProbeGI.GridMin, Size);
+}
+
+float3 ProbeGITranslatedPosition(int3 LocalCoord)
+{
+	return ProbeGI.GridMinTranslated + float3(LocalCoord) * ProbeGI.Spacing;
+}
+
+uint2 ProbeGITileOrigin(uint StorageIndex, uint TileSize)
+{
+	return uint2(StorageIndex % ProbeGI.TilesPerRow, StorageIndex / ProbeGI.TilesPerRow) * TileSize;
+}
+
+float2 ProbeGIAtlasUV(uint StorageIndex, float3 Direction, uint TileSize, uint Texels, float2 InvAtlasSize)
+{
+	const float2 Oct = UnitVectorToOctahedron(Direction) * 0.5f + 0.5f;
+	return (float2(ProbeGITileOrigin(StorageIndex, TileSize)) + 1.0f + Oct * Texels) * InvAtlasSize;
+}
+
+float3 ProbeGISkyRadiance(float3 Direction)
+{
+	const float4 NormalVector = float4(Direction, 1.0f);
+	float3 Intermediate0, Intermediate1;
+	Intermediate0.x = dot(View.SkyIrradianceEnvironmentMap[0], NormalVector);
+	Intermediate0.y = dot(View.SkyIrradianceEnvironmentMap[1], NormalVector);
+	Intermediate0.z = dot(View.SkyIrradianceEnvironmentMap[2], NormalVector);
+	const float4 vB = NormalVector.xyzz * NormalVector.yzzx;
+	Intermediate1.x = dot(View.SkyIrradianceEnvironmentMap[3], vB);
+	Intermediate1.y = dot(View.SkyIrradianceEnvironmentMap[4], vB);
+	Intermediate1.z = dot(View.SkyIrradianceEnvironmentMap[5], vB);
+	const float vC = NormalVector.x * NormalVector.x - NormalVector.y * NormalVector.y;
+	return max(0, Intermediate0 + Intermediate1 + View.SkyIrradianceEnvironmentMap[6].xyz * vC) * View.SkyLightColor.rgb;
+}
+
+/**
+ * Irradiance at a surface from the eight probes around it, as the cosine-weighted mean radiance the base pass multiplies by diffuse colour.
+ * Probes behind the surface, inside geometry, or that cannot see the point (Chebyshev test on their distance moments) are discounted.
+ * Alpha is the coverage, fading to zero over the outer probe of the grid.
+ */
+float4 SampleMobileProbeGI(float3 TranslatedWorldPosition, float3 WorldNormal, float3 ToCamera)
+{
+	if (ProbeGI.Intensity <= 0.0f)
+	{
+		return 0;
+	}
+
+	const float3 BiasedPosition = TranslatedWorldPosition + (WorldNormal * ProbeGI.NormalBias + ToCamera * ProbeGI.ViewBias) * ProbeGI.Spacing;
+	const float3 GridPosition = (BiasedPosition - ProbeGI.GridMinTranslated) / ProbeGI.Spacing;
+	const float3 Fade3 = saturate(min(GridPosition, float3(ProbeGI.GridSize - 1) - GridPosition));
+	const float Coverage = min(Fade3.x, min(Fade3.y, Fade3.z));
+	if (Coverage <= 0.0f)
+	{
+		return 0;
+	}
+
+	const int3 Base = clamp(int3(floor(GridPosition)), 0, ProbeGI.GridSize - 2);
+	const float3 Alpha = saturate(GridPosition - float3(Base));
+
+	float3 Irradiance = 0;
+	float TotalWeight = 0;
+	UNROLL
+	for (uint Corner = 0; Corner < 8; ++Corner)
+	{
+		const int3 Offset = int3(Corner & 1, (Corner >> 1) & 1, (Corner >> 2) & 1);
+		const int3 LocalCoord = Base + Offset;
+		const uint StorageIndex = ProbeGIStorageIndex(LocalCoord);
+		if (ProbeGI.ProbeState[StorageIndex] != PROBE_GI_STATE_VALID)
+		{
+			continue;
+		}
+
+		const float3 ProbePosition = ProbeGITranslatedPosition(LocalCoord);
+		const float3 Trilinear = lerp(1.0f - Alpha, Alpha, float3(Offset));
+
+		// Smooth backface test: probes behind the surface contribute little, without a hard cut
+		const float3 ToProbe = normalize(ProbePosition - TranslatedWorldPosition);
+		float Weight = Square((dot(ToProbe, WorldNormal) + 1.0f) * 0.5f) + 0.2f;
+
+		const float3 ProbeToPoint = BiasedPosition - ProbePosition;
+		const float Distance = length(ProbeToPoint);
+		const float2 Moments = Texture2DSampleLevel(ProbeGI.DistanceAtlas, ProbeGI.AtlasSampler,
+			ProbeGIAtlasUV(StorageIndex, ProbeToPoint / max(Distance, 0.0001f), PROBE_GI_DISTANCE_TILE, PROBE_GI_DISTANCE_TEXELS, ProbeGI.DistanceAtlasInvSize), 0).xy;
+		if (Distance > Moments.x)
+		{
+			const float Variance = abs(Moments.y - Moments.x * Moments.x);
+			const float Chebyshev = Variance / (Variance + Square(Distance - Moments.x));
+			Weight *= max(Chebyshev * Chebyshev * Chebyshev, 0.0f);
+		}
+
+		Weight = max(Weight, 0.000001f);
+		// Crush tiny weights so a probe that mostly fails the tests cannot leak light
+		const float CrushThreshold = 0.2f;
+		if (Weight < CrushThreshold)
+		{
+			Weight *= Square(Weight) / Square(CrushThreshold);
+		}
+		Weight *= Trilinear.x * Trilinear.y * Trilinear.z;
+
+		const float3 ProbeIrradiance = Texture2DSampleLevel(ProbeGI.IrradianceAtlas, ProbeGI.AtlasSampler,
+			ProbeGIAtlasUV(StorageIndex, WorldNormal, PROBE_GI_IRRADIANCE_TILE, PROBE_GI_IRRADIANCE_TEXELS, ProbeGI.IrradianceAtlasInvSize), 0).rgb;
+		Irradiance += ProbeIrradiance * Weight;
+		TotalWeight += Weight;
+	}
+
+	if (TotalWeight <= 0.0f)
+	{
+		return 0;
+	}
+	return float4(Irradiance / TotalWeight * ProbeGI.Intensity, Coverage);
+}
