@@ -224,6 +224,43 @@ float2 GetScreenUVFromScreenGrid(uint2 OutputCoordinate)
 
 StructuredBuffer<uint> CulledTilesStartOffsetArray;
 
+#ifndef DFAO_RECONSTRUCT_NORMAL
+#define DFAO_RECONSTRUCT_NORMAL 0
+#endif
+
+#if DFAO_RECONSTRUCT_NORMAL
+float3 DFAOScreenUVToTranslatedWorld(float2 ScreenUV, float SceneDepth)
+{
+	float2 ScreenPosition = (ScreenUV - View.ScreenPositionScaleBias.wz) / View.ScreenPositionScaleBias.xy;
+	return mul(float4(GetScreenPositionForProjectionType(ScreenPosition, SceneDepth), SceneDepth, 1), View.ScreenToTranslatedWorld).xyz;
+}
+
+/** World normal from depth. Each axis uses the neighbour with the smaller depth step, so silhouettes do not bend the normal. */
+float3 ReconstructWorldNormalFromDepth(float2 ScreenUV)
+{
+	const float2 TexelSize = View.BufferSizeAndInvSize.zw;
+	const float2 DX = float2(TexelSize.x, 0);
+	const float2 DY = float2(0, TexelSize.y);
+
+	const float Center = CalcSceneDepth(ScreenUV);
+	const float Left = CalcSceneDepth(ScreenUV - DX);
+	const float Right = CalcSceneDepth(ScreenUV + DX);
+	const float Up = CalcSceneDepth(ScreenUV - DY);
+	const float Down = CalcSceneDepth(ScreenUV + DY);
+
+	const float3 Position = DFAOScreenUVToTranslatedWorld(ScreenUV, Center);
+	const float3 TangentX = abs(Right - Center) < abs(Center - Left)
+		? DFAOScreenUVToTranslatedWorld(ScreenUV + DX, Right) - Position
+		: Position - DFAOScreenUVToTranslatedWorld(ScreenUV - DX, Left);
+	const float3 TangentY = abs(Down - Center) < abs(Center - Up)
+		? DFAOScreenUVToTranslatedWorld(ScreenUV + DY, Down) - Position
+		: Position - DFAOScreenUVToTranslatedWorld(ScreenUV - DY, Up);
+
+	const float3 Normal = normalize(cross(TangentY, TangentX));
+	return dot(Normal, Position - View.TranslatedWorldCameraOrigin) > 0 ? -Normal : Normal;
+}
+#endif
+
