+/**
+ * Direction out of a surface the probe sits on, where the gradient is unreliable and a thin two-sided surface has none: the axis
+ * with the most free space, favouring the camera's side, which is the side that is seen.
+ */
+float3 GetEscapeDirection(float3 Position)
+{
+	const float3 ToCamera = normalize(View.TranslatedWorldCameraOrigin - Position);
+	float BestScore = -1e10f;
+	float3 Best = float3(0, 0, 1);
+	UNROLL
+	for (uint Axis = 0; Axis < 6; ++Axis)
+	{
+		float3 Direction = 0;
+		Direction[Axis >> 1] = (Axis & 1) ? -1.0f : 1.0f;
+		const float Score = GetDistanceToNearestSurfaceGlobal(Position + Direction * MinSurfaceDistance) + MinSurfaceDistance * dot(Direction, ToCamera);
+		if (Score > BestScore)
+		{
+			BestScore = Score;
+			Best = Direction;
+		}
+	}
+	return Best;
+}
+
+/**
+ * Moves a probe out of the geometry around it. Near a surface, the signed global distance field pushes it out along its gradient.
+ * Deeper inside than the distance field's narrow band, a probe that sees mostly backfaces steps through the nearest one.
+ * Otherwise it backs away from its closest ray hit.
+ */
+float3 RelocateProbe(uint ProbeIndex, float3 Offset, uint Backfaces)
+{
+	const float3 Position = ProbeGITranslatedPosition(ProbeGILocalCoord(ProbeIndex)) + Offset;
+
+	float ClosestBackface = 1e10f;
+	float3 ClosestBackfaceDirection = 0;
+	float ClosestFrontface = 1e10f;
+	float3 ClosestFrontfaceDirection = 0;
+	for (uint Ray = 0; Ray < NumRays; ++Ray)
+	{
+		const float W = RayData[ProbeIndex * NumRays + Ray].w;
+		const float Distance = W < 0.0f ? -W / PROBE_GI_BACKFACE_DISTANCE_SCALE : W;
+		if (W < 0.0f && Distance < ClosestBackface)
+		{
+			ClosestBackface = Distance;
+			ClosestBackfaceDirection = GetRayDirection(Ray);
+		}
+		else if (W >= 0.0f && Distance < ClosestFrontface)
+		{
+			ClosestFrontface = Distance;
+			ClosestFrontfaceDirection = GetRayDirection(Ray);
+		}
+	}
