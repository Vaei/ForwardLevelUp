diff --git a/Engine/Shaders/Private/MobileVirtualShadowMaps.ush b/Engine/Shaders/Private/MobileVirtualShadowMaps.ush
new file mode 100644
index 000000000000..c0c8692e73db
--- /dev/null
+++ b/Engine/Shaders/Private/MobileVirtualShadowMaps.ush
@@ -0,0 +1,57 @@
+// Copyright (c) 2026 Jared Taylor.
+
+#pragma once
+
+#include "VirtualShadowMaps/VirtualShadowMapProjectionCommon.ush"
+
+#ifndef MOBILE_VSM_FILTER_TAPS
+#define MOBILE_VSM_FILTER_TAPS 5
+#endif
+
+/**
+ * Percentage-closer filtering of a virtual shadow map in the forward base pass. Taps sit on a fixed disk in the plane facing the
+ * light, about one screen pixel's footprint apart, so the penumbra is stable from frame to frame and needs no temporal filter.
+ */
+half MobileVirtualShadowMapFilter(bool bDirectional, int VirtualShadowMapId, float3 TranslatedWorldPosition, float3 WorldNormal, float3 ToLight, float SceneDepth)
+{
+	const float3 Up = abs(ToLight.z) < 0.99f ? float3(0, 0, 1) : float3(1, 0, 0);
+	const float3 TangentX = normalize(cross(ToLight, Up));
+	const float3 TangentY = cross(ToLight, TangentX);
+
+	// World size of one screen pixel at this depth, about one shadow texel, since pages are marked at screen resolution
+	const float PixelFootprint = SceneDepth * 2.0f * View.ViewSizeAndInvSize.w / View.ViewToClip[1][1];
+	const float Radius = PixelFootprint * MobileBasePass.VirtualShadowMapFilterRadius;
+
+	// Single lookups have no ray march to step off the receiver, so push the lookup off the surface instead
+	const float3 BiasedPosition = TranslatedWorldPosition + WorldNormal * (PixelFootprint * MobileBasePass.VirtualShadowMapNormalBias);
+	const float RayStartDistance = PixelFootprint * MobileBasePass.VirtualShadowMapNormalBias;
+
+#if MOBILE_VSM_FILTER_TAPS >= 9
+	const float2 Taps[9] = { float2(0, 0), float2(1, 0), float2(-1, 0), float2(0, 1), float2(0, -1), float2(0.707f, 0.707f), float2(-0.707f, 0.707f), float2(0.707f, -0.707f), float2(-0.707f, -0.707f) };
+	const int NumTaps = 9;
+#elif MOBILE_VSM_FILTER_TAPS >= 5
+	const float2 Taps[5] = { float2(0, 0), float2(0.707f, 0.707f), float2(-0.707f, 0.707f), float2(0.707f, -0.707f), float2(-0.707f, -0.707f) };
+	const int NumTaps = 5;
+#else
+	const float2 Taps[1] = { float2(0, 0) };
+	const int NumTaps = 1;
+#endif
+
+	half Lit = 0.0f;
+	UNROLL
+	for (int TapIndex = 0; TapIndex < NumTaps; ++TapIndex)
+	{
+		const float3 TapPosition = BiasedPosition + (TangentX * Taps[TapIndex].x + TangentY * Taps[TapIndex].y) * Radius;
+		FVirtualShadowMapSampleResult Result;
+		if (bDirectional)
+		{
+			Result = SampleVirtualShadowMapDirectional(VirtualShadowMapId, TapPosition, RayStartDistance, WorldNormal, true, SceneDepth);
+		}
+		else
+		{
+			Result = SampleVirtualShadowMapLocal(VirtualShadowMapId, TapPosition, RayStartDistance, WorldNormal, true, SceneDepth);
+		}
+		Lit += half(Result.ShadowFactor);
+	}
+	return Lit / half(NumTaps);
+}
