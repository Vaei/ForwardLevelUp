+	TEXT("Radius of the mobile forward virtual shadow map filter, in screen pixels at the receiver. 0 gives hard edges."),
+	ECVF_Scalability | ECVF_RenderThreadSafe);
+
+static TAutoConsoleVariable<int32> CVarMobileVirtualShadowMapsFilterTaps(
+	TEXT("r.Mobile.VirtualShadowMaps.FilterTaps"),
+	5,
+	TEXT("Shadow map lookups per light per pixel for the mobile forward virtual shadow map filter: 1, 5 or 9.\n")
+	TEXT("Read only, recompiles materials."),
+	ECVF_ReadOnly | ECVF_RenderThreadSafe);
+
+static TAutoConsoleVariable<float> CVarMobileVirtualShadowMapsNormalBias(
+	TEXT("r.Mobile.VirtualShadowMaps.NormalBias"),
+	2.0f,
+	TEXT("How far each shadow lookup steps off the receiver, along its normal and towards the light, in screen pixels at the receiver. Raise it if surfaces shadow themselves in stripes."),
+	ECVF_Scalability | ECVF_RenderThreadSafe);
+
+float GetMobileVirtualShadowMapNormalBias()
+{
+	return FMath::Max(CVarMobileVirtualShadowMapsNormalBias.GetValueOnRenderThread(), 0.0f);
+}
+
+float GetMobileVirtualShadowMapFilterRadius()
+{
+	return FMath::Max(CVarMobileVirtualShadowMapsFilterRadius.GetValueOnRenderThread(), 0.0f);
+}
+
+void CheckMobileVirtualShadowMapsRHI(EShaderPlatform Platform)
+{
+	if (IsMobileVirtualShadowMapsEnabled(Platform) && IsD3DPlatform(Platform) && RHIGetInterfaceType() == ERHIInterfaceType::D3D11)
+	{
+		UE_LOG(LogRenderer, Fatal, TEXT("r.Mobile.VirtualShadowMaps compiles shadow shaders with DXC, which DirectX 11 cannot run. Use DirectX 12 (-d3d12, or DefaultGraphicsRHI_DX12), or turn r.Mobile.VirtualShadowMaps off."));
+	}
+}
+
+void SetMobileVirtualShadowMapBasePassDefines(EShaderPlatform Platform, bool bTranslucentMaterial, FShaderCompilerEnvironment& OutEnvironment)
+{
+	// Pages are marked from the opaque depth prepass, so translucency would only find unmarked pages
+	const bool bEnabled = !bTranslucentMaterial && IsMobileVirtualShadowMapsEnabled(Platform);
+	OutEnvironment.SetDefine(TEXT("MOBILE_VIRTUAL_SHADOW_MAP"), bEnabled ? 1u : 0u);
+	if (bEnabled)
+	{
+		OutEnvironment.SetDefine(TEXT("MOBILE_VSM_FILTER_TAPS"), FMath::Clamp(CVarMobileVirtualShadowMapsFilterTaps.GetValueOnAnyThread(), 1, 9));
+		FVirtualShadowMapArray::SetShaderDefines(OutEnvironment);
+	}
+}
+
+TRDGUniformBufferRef<FVirtualShadowMapUniformParameters> GetMobileVirtualShadowMapUniformBuffer(FRDGBuilder& GraphBuilder, const FVirtualShadowMapArray& VirtualShadowMapArray, EShaderPlatform Platform, int32 ViewIndex)
+{
+	if (!IsMobileVirtualShadowMapsEnabled(Platform))
+	{
+		return nullptr;
+	}
+
+	// Initialize fills the cached buffers over dummy data, which the shadow depths pass replaces once pages exist
+	return VirtualShadowMapArray.GetUniformBuffer(ViewIndex);
+}
+
+void FMobileSceneRenderer::BeginMarkMobileVirtualShadowMapPages(FRDGBuilder& GraphBuilder, FSceneTextures& SceneTextures)
+{
+	TRACE_CPUPROFILER_EVENT_SCOPE(MobileSceneRenderer::BeginMarkMobileVirtualShadowMapPages);
+
+	FShadowSceneRenderer* ShadowSceneRenderer = GetSceneExtensionsRenderers().GetRendererPtr<FShadowSceneRenderer>();
+	if (!ShadowSceneRenderer || !VirtualShadowMapArray.IsEnabled() || !HasBeenProduced(SceneTextures.Depth.Resolve))
+	{
+		return;
+	}
+
+	// Page marking reads depth through the deferred scene texture uniform buffer, which mobile does not otherwise create
+	FSceneTextureUniformParameters* SceneTextureParameters = GraphBuilder.AllocParameters<FSceneTextureUniformParameters>();
+	SetupSceneTextureUniformParameters(GraphBuilder, &SceneTextures, FeatureLevel, ESceneTextureSetupMode::SceneDepth, *SceneTextureParameters);
+	// Mobile has no partial depth
+	SceneTextureParameters->ScenePartialDepthTexture = SceneTextureParameters->SceneDepthTexture;
+	SceneTextures.UniformBuffer = GraphBuilder.CreateUniformBuffer(SceneTextureParameters);
+
+	ShadowSceneRenderer->BeginMarkVirtualShadowMapPages(GraphBuilder, nullptr, FFrontLayerTranslucencyData(), Froxel::FRenderer());
+}
+
+void FMobileSceneRenderer::ExtractMobileVirtualShadowMapFrameData(FRDGBuilder& GraphBuilder)
+{
+	TRACE_CPUPROFILER_EVENT_SCOPE(MobileSceneRenderer::ExtractMobileVirtualShadowMapFrameData);
+
+	// Runs even with virtual shadow maps off this frame, to drop data a previous frame extracted
+	if (FVirtualShadowMapArrayCacheManager* CacheManager = VirtualShadowMapArray.CacheManager)
+	{
+		CacheManager->ExtractFrameData(GraphBuilder, VirtualShadowMapArray, *this, ViewFamily.EngineShowFlags.VirtualShadowMapPersistentData);
+	}
+}
