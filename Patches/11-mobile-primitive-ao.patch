+// Copyright (c) 2026 Jared Taylor.
+
+#pragma once
+
+Texture2D SceneDepthTexture;
+
+float3 PixelToTranslatedWorld(int2 Pixel)
+{
+	const float DeviceZ = SceneDepthTexture.Load(int3(Pixel, 0)).r;
+	const float4 Position = mul(float4(Pixel + 0.5, DeviceZ, 1), View.SVPositionToTranslatedWorld);
+	return Position.xyz / Position.w;
+}
+
+/** Each axis uses the neighbour with the smaller step, so silhouettes do not bend the normal. */
+float3 ReconstructNormal(int2 Pixel, float3 Center)
+{
+	const float3 Left = PixelToTranslatedWorld(Pixel - int2(1, 0));
+	const float3 Right = PixelToTranslatedWorld(Pixel + int2(1, 0));
+	const float3 Up = PixelToTranslatedWorld(Pixel - int2(0, 1));
+	const float3 Down = PixelToTranslatedWorld(Pixel + int2(0, 1));
+
+	const float3 TangentX = length2(Right - Center) < length2(Center - Left) ? Right - Center : Center - Left;
+	const float3 TangentY = length2(Down - Center) < length2(Center - Up) ? Down - Center : Center - Up;
+	const float3 Normal = normalize(cross(TangentY, TangentX));
+	return dot(Normal, Center - View.TranslatedWorldCameraOrigin) > 0 ? -Normal : Normal;
+}
