diff --git a/Engine/Shaders/Private/MobilePrimitiveAO.usf b/Engine/Shaders/Private/MobilePrimitiveAO.usf
new file mode 100644
index 000000000000..0c1a55ed0c1c
--- /dev/null
+++ b/Engine/Shaders/Private/MobilePrimitiveAO.usf
@@ -0,0 +1,85 @@
+// Copyright (c) 2026 Jared Taylor.
+
+#include "Common.ush"
+#include "MobileAOReconstruction.ush"
+
+StructuredBuffer<float4> Shapes;
+float MaxDistance;
+float Intensity;
+
+void MainVS(
+	float4 InPosition : ATTRIBUTE0,
+	float4 InPrimitive : ATTRIBUTE1,
+	out nointerpolation float4 OutPrimitive : TEXCOORD0,
+	out float4 OutPosition : SV_POSITION)
+{
+	OutPosition = mul(float4(InPosition.xyz, 1), View.TranslatedWorldToClip);
+	OutPrimitive = InPrimitive;
+}
+
+/** Cosine-weighted share of the hemisphere above the surface that a sphere covers, fading out MaxDistance past its surface. */
+float SphereOcclusion(float3 ToCenter, float3 Normal, float Radius, float SurfaceDistance)
+{
+	const float Distance = max(length(ToCenter), Radius);
+	const float Cosine = saturate(dot(Normal, ToCenter) / Distance);
+	const float Fade = saturate(1 - SurfaceDistance / MaxDistance);
+	return saturate(Cosine * Square(Radius / Distance)) * Fade * Fade;
+}
+
+float CapsuleOcclusion(float3 Position, float3 Normal, float3 A, float3 B, float Radius)
+{
+	const float3 Axis = B - A;
+	const float T = saturate(dot(Position - A, Axis) / max(dot(Axis, Axis), 1e-4));
+	const float3 ToCenter = A + Axis * T - Position;
+	return SphereOcclusion(ToCenter, Normal, Radius, max(length(ToCenter) - Radius, 0));
+}
+
+/** The ellipsoid is scaled to a unit sphere, which moves the receiver and bends its normal with it. */
+float EllipsoidOcclusion(float3 Position, float3 Normal, float3 Center, float4 AxisX, float4 AxisY, float4 AxisZ)
+{
+	const float3 Offset = Position - Center;
+	const float3 UnitPosition = float3(dot(Offset, AxisX.xyz), dot(Offset, AxisY.xyz), dot(Offset, AxisZ.xyz));
+	const float3 UnitNormal = normalize(float3(dot(Normal, AxisX.xyz) * Square(AxisX.w), dot(Normal, AxisY.xyz) * Square(AxisY.w), dot(Normal, AxisZ.xyz) * Square(AxisZ.w)));
+	const float UnitDistance = length(UnitPosition);
+	// Surface distance in world units along the receiver's direction from the centre
+	const float SurfaceDistance = max(UnitDistance - 1, 0) * length(Offset) / max(UnitDistance, 1e-4);
+	return SphereOcclusion(-UnitPosition, UnitNormal, 1, SurfaceDistance);
+}
+
+void MainPS(
+	nointerpolation float4 Primitive : TEXCOORD0,
+	float4 SvPosition : SV_POSITION,
+	out float4 OutColor : SV_Target0)
+{
+	const int2 Pixel = int2(SvPosition.xy);
+	if (SceneDepthTexture.Load(int3(Pixel, 0)).r == FarDepthValue)
+	{
+		OutColor = 1;
+		return;
+	}
+
+	const float3 Position = PixelToTranslatedWorld(Pixel);
+	const float3 Normal = ReconstructNormal(Pixel, Position);
+
+	const uint FirstShape = (uint)Primitive.x;
+	const uint NumShapes = (uint)Primitive.y;
+	float Visibility = 1;
+	for (uint ShapeIndex = FirstShape; ShapeIndex < FirstShape + NumShapes; ShapeIndex++)
+	{
+		const float4 Shape0 = Shapes[ShapeIndex * 4 + 0];
+		const float4 Shape1 = Shapes[ShapeIndex * 4 + 1];
+		float Occlusion;
+		if (Shape0.w < 0.5)
+		{
+			Occlusion = CapsuleOcclusion(Position, Normal, Shape0.xyz, Shape1.xyz, Shape1.w);
+		}
+		else
+		{
+			Occlusion = EllipsoidOcclusion(Position, Normal, Shape0.xyz, Shape1, Shapes[ShapeIndex * 4 + 2], Shapes[ShapeIndex * 4 + 3]);
+		}
+		Visibility *= 1 - Occlusion;
+	}
+
+	Visibility = max(Visibility, Primitive.z);
+	OutColor = float4(lerp(1, Visibility, Intensity), 0, 0, 0);
+}
diff --git a/Engine/Source/Runtime/Renderer/Private/MobilePrimitiveAO.cpp b/Engine/Source/Runtime/Renderer/Private/MobilePrimitiveAO.cpp
