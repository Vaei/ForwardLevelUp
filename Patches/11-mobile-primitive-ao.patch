index 000000000000..0768ead97670
--- /dev/null
+++ b/Engine/Source/Runtime/Renderer/Private/MobilePrimitiveAORendering.h
@@ -0,0 +1,16 @@
+// Copyright (c) 2026 Jared Taylor.
+
+#pragma once
+
+#include "CoreMinimal.h"
+
+class FRDGBuilder;
+class FRDGTexture;
+class FScene;
+class FViewInfo;
